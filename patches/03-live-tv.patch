+@Composable
+private fun LiveTvSourceCard(
+    sourceUrl: String,
+    isLoading: Boolean,
+    errorMessage: String?,
+    hasConnectedSource: Boolean,
+    onSourceUrlChange: (String) -> Unit,
+    onLoad: () -> Unit,
+    onDisconnect: () -> Unit,
+) {
+    val tokens = MaterialTheme.nuvio
+    Surface(
+        modifier = Modifier.fillMaxWidth(),
+        color = tokens.colors.surface,
+        shape = tokens.shapes.card,
