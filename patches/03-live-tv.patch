+            return doc.renameTo(other.fileName)
+        }
+        return false
+    }
+    override fun copyTo(other: DownloadTarget) {
+        val doc = getDoc() ?: return
+        context.contentResolver.openInputStream(doc.uri)?.use { input ->
+            other.openOutputStream(false).use { output ->
+                input.copyTo(output)
+            }
