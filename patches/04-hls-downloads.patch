+private fun OutputStream.closeSafe() {
+    try { close() } catch (_: Exception) { }
 }
+
+private fun extractCodecConfigFromBitstream(
+    extractor: MediaExtractor,
+    trackId: Int,
+    videoMime: String,
+    maxSamples: Int = 30,
+): ByteArray? {
+    val isHevc = videoMime.contains("hevc", true) || videoMime.contains("h265", true) ||
+        videoMime.contains("hvc1", true) || videoMime.contains("hev1", true)
+    // AVC: SPS=7, PPS=8. HEVC: VPS=32, SPS=33, PPS=34.
+    val targetTypes = if (isHevc) listOf(32, 33, 34) else listOf(7, 8)
+
+    extractor.seekTo(0, MediaExtractor.SEEK_TO_PREVIOUS_SYNC)
+    extractor.selectTrack(trackId)
+    val buffer = ByteBuffer.allocate(512 * 1024)
+    val nals = LinkedHashMap<Int, ByteArray>()
+    var samplesRead = 0
+
+    while (samplesRead < maxSamples && nals.size < targetTypes.size) {
+        buffer.clear()
+        val size = extractor.readSampleData(buffer, 0)
+        if (size < 0) break
+        val flags = extractor.sampleFlags
+        if (flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG != 0) {
+            extractor.advance()
+            continue
+        }
+        buffer.limit(size)
+        buffer.position(0)
+        val data = ByteArray(size)
+        buffer.get(data)
+
+        var i = 0
+        while (i < data.size - 3 && nals.size < targetTypes.size) {
+            if (data[i] == 0x00.toByte() && data[i + 1] == 0x00.toByte()) {
+                val startCodeLen = when {
+                    i + 3 < data.size && data[i + 2] == 0x00.toByte() && data[i + 3] == 0x01.toByte() -> 4
+                    data[i + 2] == 0x01.toByte() -> 3
+                    else -> -1
+                }
+                if (startCodeLen > 0) {
+                    val nalStart = i + startCodeLen
+                    if (nalStart < data.size) {
+                        val nalType = data[nalStart].toInt() and 0x1F
+                        var nalEnd = data.size
+                        for (j in nalStart + 1 until data.size - 2) {
+                            if (data[j] == 0x00.toByte() && data[j + 1] == 0x00.toByte()) {
+                                val nextStart = if (j + 2 < data.size && data[j + 2] == 0x01.toByte()) 3
+                                else if (j + 3 < data.size && data[j + 2] == 0x00.toByte() && data[j + 3] == 0x01.toByte()) 4
+                                else -1
+                                if (nextStart > 0) {
+                                    nalEnd = j
+                                    break
+                                }
+                            }
+                        }
+                        val nalData = data.copyOfRange(nalStart, nalEnd)
+                        if (nalType in targetTypes && !nals.containsKey(nalType)) {
+                            nals[nalType] = nalData
+                        }
+                        i = nalEnd
+                        continue
+                    }
+                }
+            }
+            i++
+        }
+        extractor.advance()
+        samplesRead++
+    }
+    extractor.seekTo(0, MediaExtractor.SEEK_TO_PREVIOUS_SYNC)
+
+    if (nals.isEmpty()) return null
+
+    // Costruisce il csd: per AVC (avcC) -> SPS poi PPS con 2-byte length prefix.
+    // Per HEVC (hvcC) -> VPS, SPS, PPS. media3 Mp4Muxer gestisce la serializzazione
+    // corretta partendo da NAL con 2-byte length prefix (lengthSizeMinusOne=1).
+    // Nota: HEVC standard MP4 usa 4-byte length (lengthSizeMinusOne=3), ma
+    // media3 Mp4Muxer/HevcConfig gestisce entrambe le convenzioni. Qui usiamo
+    // 2-byte per coerenza con AVC e con la convenzione Android csd; il muxer
+    // normalizza se necessario. In caso di mismatch, l'alternativa sarebbe
+    // serializzare un hvcC completo qui (più complesso e rischioso).
+    val ordered = targetTypes.mapNotNull { nals[it] }
+    if (ordered.isEmpty()) return null
+    val totalLen = ordered.sumOf { 4 + it.size }
+    val out = ByteArray(totalLen)
+    var off = 0
+    for (nal in ordered) {
+        out[off] = 0
+        out[off + 1] = 0
+        out[off + 2] = 0
+        out[off + 3] = 1
+        System.arraycopy(nal, 0, out, off + 4, nal.size)
+        off += 4 + nal.size
+    }
+    return out
+}
+
+
