+private fun formatBandwidth(bandwidth: Long): String {
+    if (bandwidth <= 0L) return ""
+    val mbpsX10 = (bandwidth * 10) / 1_000_000
+    val whole = mbpsX10 / 10
+    val frac = mbpsX10 % 10
+    return if (frac > 0) "$whole.$frac Mbps" else "$whole Mbps"
+}
+
+private fun friendlyCodec(codecs: String): String {
+    val lower = codecs.lowercase()
+    return when {
+        lower.contains("av01") || lower.contains("av1") -> "AV1"
+        lower.contains("hev1") || lower.contains("hvc1") || lower.contains("hevc") -> "HEVC"
+        lower.contains("avc1") || lower.contains("h264") -> "H.264"
+        lower.contains("vp9") -> "VP9"
+        lower.contains("vp8") -> "VP8"
+        else -> ""
+    }
+}
+
+internal fun parseResolutionPixels(resolution: String?): Long {
+    if (resolution.isNullOrBlank()) return 0L
+    val parts = resolution.split('x', 'X')
+    if (parts.size == 2) {
+        val w = parts[0].trim().toLongOrNull() ?: 0L
+        val h = parts[1].trim().toLongOrNull() ?: 0L
+        return w * h
+    }
+    return 0L
+}
+
+internal fun isItalianTrack(track: HlsMediaTrack): Boolean {    val lang = track.language?.trim()?.lowercase()
+    val name = track.name.trim().lowercase()
+
+    if (lang != null && (lang == "it" || lang == "ita" || lang == "italian" || lang == "italiano" || lang.startsWith("it-") || lang.startsWith("it_"))) {
+        return true
+    }
+    if (languageMatchesPreference(track.language, "it")) {
+        return true
+    }
+    if (languageMatchesPreference(track.name, "it")) {
+        return true
+    }
+    if (name == "it" || name == "ita" || name == "italian" || name == "italiano") {
+        return true
+    }
+    if (name.contains("italiano") || name.contains("italian")) {
+        return true
+    }
+    if (Regex("""\b(ita|it)\b""", RegexOption.IGNORE_CASE).containsMatchIn(track.name)) {
+        return true
+    }
+    return false
+}
+
+/**
+ * Ordine di preferenza audio: ITA > DEFAULT > ENG > prima disponibile.
+ * Obiettivo utente: sempre italiano; se manca (solo ENG) scarica ENG lo stesso.
+ */
+internal fun selectPreferredAudioUri(tracks: List<HlsMediaTrack>): String? {
+    if (tracks.isEmpty()) return null
+    val italian = tracks.filter { isItalianTrack(it) }
+    if (italian.isNotEmpty()) {
+        return italian.firstOrNull { it.isDefault }?.uri ?: italian.firstOrNull()?.uri
+    }
+    tracks.firstOrNull { it.isDefault }?.uri?.let { return it }
+    tracks.firstOrNull { it.language?.trim()?.lowercase()?.startsWith("eng") == true }?.uri?.let { return it }
+    return tracks.firstOrNull()?.uri
+}
