+import org.jetbrains.compose.resources.stringResource
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun DownloadsHlsSelectionSheet(
+    stream: StreamItem?,
+    onDismiss: () -> Unit,
+    onDownload: (HlsDownloadSelection) -> Unit,
+) {
+    if (stream == null) return
+
+    val sheetState = rememberNuvioBottomSheetState(skipPartiallyExpanded = true)
+    val coroutineScope = rememberCoroutineScope()
+    var hlsMetadata by remember { mutableStateOf<HlsStreamMetadata?>(null) }
+    var isFetching by remember { mutableStateOf(true) }
+    var fetchError by remember { mutableStateOf(false) }
+
+    LaunchedEffect(stream) {
+        isFetching = true
+        fetchError = false
+        val metadata = withContext(Dispatchers.Default) {
+            DownloadsRepository.fetchHlsMasterPlaylist(stream)
+        }
+        hlsMetadata = metadata
+        isFetching = false
+        if (metadata == null) {
+            fetchError = true
+        }
+    }
+
+    val playlist = hlsMetadata?.masterPlaylist
+
+    val sortedVariants = remember(playlist) {
+        playlist?.variants?.sortedWith(
+            compareByDescending<HlsVariant> { parseResolutionPixels(it.resolution) }
+                .thenByDescending { it.bandwidth }
+        ).orEmpty()
+    }
+
+    val qualityOptions = remember(sortedVariants) {
+        sortedVariants.map { variant ->
+            val label = buildString {
+                variant.resolution?.let { append(it) }
+                if (variant.resolution != null) append(" • ")
+                append(formatBandwidth(variant.bandwidth))
+                variant.codecs?.let { codecs ->
+                    val codecLabel = friendlyCodec(codecs)
+                    if (codecLabel.isNotBlank()) {
+                        append(" • ")
+                        append(codecLabel)
+                    }
+                }
+            }
+            NuvioDropdownOption(
+                key = "${variant.url}_${variant.bandwidth}",
+                label = label,
+            )
+        }
+    }
+
+    val audioTracks = remember(playlist) {
+        playlist?.audioTracks?.filter { it.uri != null }.orEmpty()
+    }
+    val subtitleTracks = remember(playlist) {
+        playlist?.subtitleTracks?.filter { it.uri != null }.orEmpty()
+    }
+
+    var selectedQualityKey by remember(qualityOptions) {
+        mutableStateOf(qualityOptions.firstOrNull()?.key)
+    }
+    var selectedSubtitleKey by remember(subtitleTracks) {
+        mutableStateOf<String?>(null)
+    }
+
+    // Variante selezionata -> gruppo audio richiesto (VixSrc: AUDIO="audio").
+    // Mostriamo solo le tracce del gruppo compatibile; fallback a tutte se il
+    // gruppo non matcha (playlist senza GROUP-ID o quote residue).
+    val selectedVariantAudioGroup = remember(sortedVariants, selectedQualityKey) {
+        sortedVariants.firstOrNull { "${it.url}_${it.bandwidth}" == selectedQualityKey }?.audioGroup
+    }
+    val visibleAudioTracks = remember(audioTracks, selectedVariantAudioGroup) {
+        val group = selectedVariantAudioGroup?.trim()?.takeIf { it.isNotEmpty() }
+        if (group == null) {
+            audioTracks
+        } else {
+            val filtered = audioTracks.filter { it.groupId.trim() == group }
+            if (filtered.isNotEmpty()) filtered else audioTracks
+        }
+    }
+
+    var selectedAudioKey by remember(visibleAudioTracks) {
+        mutableStateOf(selectPreferredAudioUri(visibleAudioTracks))
+    }
+
+    LaunchedEffect(qualityOptions) {
+        if (qualityOptions.isNotEmpty() && (selectedQualityKey == null || qualityOptions.none { it.key == selectedQualityKey })) {
+            selectedQualityKey = qualityOptions.firstOrNull()?.key
+        }
+    }
+
+    LaunchedEffect(audioTracks, selectedVariantAudioGroup) {
+        if (visibleAudioTracks.isNotEmpty() && (selectedAudioKey == null || visibleAudioTracks.none { it.uri == selectedAudioKey })) {
+            selectedAudioKey = selectPreferredAudioUri(visibleAudioTracks)
+        }
+    }
+
+    val hasAudio = visibleAudioTracks.isNotEmpty()
+    val hasSubtitles = subtitleTracks.isNotEmpty()
+    val canDownload = qualityOptions.isNotEmpty()
+
+    NuvioModalBottomSheet(
+        onDismissRequest = {
+            coroutineScope.launch {
+                dismissNuvioBottomSheet(sheetState = sheetState, onDismiss = onDismiss)
