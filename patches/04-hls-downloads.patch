+package com.nuvio.app.features.downloads
+
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+
+internal class HlsHttpResult(
+    val status: Int,
+    val body: ByteArray,
+    val finalUrl: String,
+)
+
+internal class HlsDownloadOutcome(
+    val isFmp4: Boolean,
+    val totalBytes: Long,
+)
+
+internal class HlsDownloadException(message: String) : Exception(message)
+
+private const val MAX_PLAYLIST_REDIRECTS = 4
+private const val AES_128 = "AES-128"
+private const val BITRATE_WARMUP_FRACTION = 0.08
+private const val DEFAULT_SEGMENT_CONCURRENCY = 4
+private const val MAX_HTTP_RETRY_ATTEMPTS = 3
+
+private class ResolvedHlsMedia(
+    val playlist: HlsMediaPlaylist,
+    val declaredBitsPerSecond: Long?,
+)
+
+private class IndexedSegmentPayload(
+    val index: Int,
+    val segment: HlsSegment,
+    val payload: ByteArray,
+)
+
+/**
+ * Esito della consegna di un singolo segmento dalla coda di download.
+ * Ogni segmento consegna ESATTAMENTE un evento: il payload (successo) oppure
+ * l'errore (fallimento definitivo dopo i retry). I coroutine dei segmenti non
+ * lanciano MAI eccezioni non-cancellazione: se lanciassero, un segmento in coda
+ * "pigro" che fallisce dopo che l'ultimo byte è già stato scritto farebbe
+ * fallire l'intero download a file ormai completo ("scaricato ma non salvato").
+ */
+private sealed interface SegmentDelivery {
+    class Payload(val item: IndexedSegmentPayload) : SegmentDelivery
+    class Failed(val index: Int, val error: Throwable) : SegmentDelivery
+}
+
+/**
+ * Esegue una richiesta HTTP HLS con retry su errori transienti.
+ * Un singolo segmento che risponde 403/429/5xx (rate limit, edge CDN instabile,
+ * token momentaneamente scaduto) NON deve far fallire l'intero download.
+ * Un 502/503 sul fetch della playlist (i CDN debrid sono notoriamente instabili)
+ * viene ritentato con backoff più ampio prima di arrendersi.
+ */
+private suspend fun httpGetWithRetry(
+    httpGet: suspend (url: String, range: HlsByteRange?) -> HlsHttpResult,
+    url: String,
+    range: HlsByteRange?,
+    ensureActive: () -> Unit,
+): HlsHttpResult {
+    var attempt = 0
+    while (true) {
+        ensureActive()
+        val result = try {
+            httpGet(url, range)
+        } catch (e: Throwable) {
+            if (e is kotlinx.coroutines.CancellationException) throw e
+            if (attempt >= MAX_HTTP_RETRY_ATTEMPTS) throw e
+            attempt++
+            delay(retryBackoffMs(attempt))
+            continue
+        }
+        if (isTransientHttpStatus(result.status) && attempt < MAX_HTTP_RETRY_ATTEMPTS) {
+            attempt++
+            delay(retryBackoffMs(attempt))
+            continue
+        }
+        return result
+    }
+}
+
+private fun isTransientHttpStatus(status: Int): Boolean =
+    status == 408 || status == 429 || status >= 500
+
+private fun retryBackoffMs(attempt: Int): Long =
+    when (attempt) {
+        1 -> 800L
+        2 -> 2_000L
+        else -> 4_000L
+    }
+
+internal suspend fun downloadHlsToFile(
+    sourceUrl: String,
+    httpGet: suspend (url: String, range: HlsByteRange?) -> HlsHttpResult,
+    appendBytes: (ByteArray) -> Unit,
+    decryptAes128Cbc: (data: ByteArray, key: ByteArray, iv: ByteArray) -> ByteArray,
+    onProgress: (downloadedBytes: Long, totalBytes: Long?) -> Unit,
+    ensureActive: () -> Unit,
+): HlsDownloadOutcome {
+    // Tutte le richieste HTTP del motore passano dal retry (playlist, init, key, segmenti).
+    val resilientHttpGet: suspend (String, HlsByteRange?) -> HlsHttpResult = { url, range ->
+        httpGetWithRetry(httpGet, url, range, ensureActive)
+    }
+
+    val resolved = resolveMediaPlaylist(sourceUrl, resilientHttpGet, ensureActive)
+    val media = resolved.playlist
+    val segments = media.segments
+    if (segments.isEmpty()) {
+        throw HlsDownloadException("HLS playlist contained no segments")
+    }
+
+    onProgress(0L, null)
+    var cumulativeBytes = 0L
+    val keyCache = HashMap<String, ByteArray>()
+    val keyMutex = Mutex()
+
+    media.initSection?.let { init ->
+        ensureActive()
+        val response = resilientHttpGet(init.url, init.byteRange)
+        if (response.status !in 200..299) {
+            throw HlsDownloadException("HLS init section failed (HTTP ${response.status})")
+        }
+        appendBytes(response.body)
+        cumulativeBytes += response.body.size.toLong()
+    }
+
+    val totalDuration = segments.sumOf { it.durationSeconds }
+    val warmupDuration = totalDuration * BITRATE_WARMUP_FRACTION
+    var totalBytesEstimate: Long? = declaredTotalBytes(resolved.declaredBitsPerSecond, totalDuration)
+    var elapsedDuration = 0.0
+    val totalSegments = segments.size
+
+    val concurrency = DEFAULT_SEGMENT_CONCURRENCY.coerceAtMost(totalSegments).coerceAtLeast(1)
+    val channel = Channel<SegmentDelivery>(capacity = concurrency * 2)
+    val segmentQueue = Channel<IndexedValue<HlsSegment>>(capacity = Channel.UNLIMITED)
+
+    coroutineScope {
+        segments.forEachIndexed { index, segment ->
+            segmentQueue.trySend(IndexedValue(index, segment))
+        }
+        segmentQueue.close()
+
+        val workers = (0 until concurrency).map {
+            launch {
+                for (item in segmentQueue) {
+                    val index = item.index
+                    val segment = item.value
+                    try {
+                        ensureActive()
+                        val response = resilientHttpGet(segment.url, segment.byteRange)
+                        if (response.status !in 200..299) {
+                            deliver(
+                                channel,
+                                SegmentDelivery.Failed(
+                                    index,
+                                    HlsDownloadException(
+                                        "HLS segment ${index + 1}/$totalSegments failed (HTTP ${response.status})",
+                                    ),
+                                ),
+                            )
+                            continue
+                        }
+
+                        val payload = decryptSegmentIfNeeded(
+                            data = response.body,
+                            encryption = segment.encryption,
+                            sequenceNumber = segment.sequenceNumber,
+                            keyCache = keyCache,
+                            keyMutex = keyMutex,
+                            httpGet = resilientHttpGet,
+                            decryptAes128Cbc = decryptAes128Cbc,
+                            ensureActive = ensureActive,
+                        )
+
+                        deliver(channel, SegmentDelivery.Payload(IndexedSegmentPayload(index, segment, payload)))
+                    } catch (e: Throwable) {
+                        if (e is kotlinx.coroutines.CancellationException) throw e
+                        deliver(channel, SegmentDelivery.Failed(index, e))
+                    }
+                }
+            }
+        }
+
+        var nextExpected = 0
+        val pending = mutableMapOf<Int, IndexedSegmentPayload>()
+        val failedIndexes = mutableSetOf<Int>()
+        var firstFailure: Throwable? = null
+        try {
+            for (delivery in channel) {
+                when (delivery) {
+                    is SegmentDelivery.Payload -> {
+                        val item = delivery.item
+                        // Già scritto su disco: irrilevante (non può succedere, per sicurezza).
+                        if (item.index < nextExpected) continue
+                        pending[item.index] = item
+                    }
+                    is SegmentDelivery.Failed -> {
+                        // Il segmento è già stato scritto su disco: il suo fallimento
+                        // tardivo NON deve più far fallire il download.
+                        if (delivery.index < nextExpected) continue
+                        if (firstFailure == null) firstFailure = delivery.error
+                        failedIndexes += delivery.index
+                    }
+                }
+
+                while (pending.containsKey(nextExpected)) {
+                    val next = pending.remove(nextExpected)!!
+                    ensureActive()
+                    appendBytes(next.payload)
+                    cumulativeBytes += next.payload.size.toLong()
+                    elapsedDuration += next.segment.durationSeconds
+
+                    if (totalBytesEstimate == null && totalDuration > 0.0 && elapsedDuration >= warmupDuration) {
+                        totalBytesEstimate = (cumulativeBytes.toDouble() / elapsedDuration * totalDuration).toLong()
+                    }
+                    onProgress(cumulativeBytes, totalBytesEstimate?.coerceAtLeast(cumulativeBytes))
+                    nextExpected++
+                }
+
+                if (nextExpected == totalSegments) {
+                    break
+                }
+
+                // Tutti i segmenti mancanti sono già stati dichiarati falliti o sono
+                // in coda fuori ordine, e il prossimo atteso non può più arrivare:
+                // il download è irrecuperabile, falliamo subito con l'errore reale.
+                val unreachable =
+                    failedIndexes.isNotEmpty() &&
+                        !pending.containsKey(nextExpected) &&
+                        pending.size + failedIndexes.size == totalSegments - nextExpected
+                if (unreachable) {
+                    throw firstFailure ?: HlsDownloadException("HLS segment download failed")
+                }
+            }
+        } finally {
+            channel.close()
+            workers.forEach { it.cancel() }
+        }
+    }
+
+    return HlsDownloadOutcome(isFmp4 = media.isFmp4, totalBytes = cumulativeBytes)
+}
+
+/**
+ * Consegna un evento sulla coda dei segmenti. Se la coda è stata chiusa
+ * (consumatore uscito con tutti i segmenti scritti), la consegna viene
+ * semplicemente scartata: un errore di "canale chiuso" non deve mai
+ * propagarsi e far fallire un download già completo.
+ */
+private suspend fun deliver(channel: Channel<SegmentDelivery>, delivery: SegmentDelivery) {
+    try {
+        channel.send(delivery)
+    } catch (_: Throwable) {
+        // Channel closed/cancelled: consegna tardiva irrilevante.
+    }
+}
+
+private suspend fun decryptSegmentIfNeeded(
+    data: ByteArray,
+    encryption: HlsSegmentEncryption?,
+    sequenceNumber: Long,
+    keyCache: MutableMap<String, ByteArray>,
+    keyMutex: Mutex,
+    httpGet: suspend (url: String, range: HlsByteRange?) -> HlsHttpResult,
+    decryptAes128Cbc: (data: ByteArray, key: ByteArray, iv: ByteArray) -> ByteArray,
+    ensureActive: () -> Unit,
+): ByteArray {
+    if (encryption == null) return data
+    if (encryption.method != AES_128) {
+        throw HlsDownloadException("Unsupported HLS encryption method: ${encryption.method}")
+    }
+
+    val cachedKey = keyMutex.withLock { keyCache[encryption.keyUrl] }
+    val key = if (cachedKey != null) {
+        cachedKey
+    } else {
+        ensureActive()
+        val keyResponse = httpGet(encryption.keyUrl, null)
+        if (keyResponse.status !in 200..299) {
+            throw HlsDownloadException("HLS key fetch failed (HTTP ${keyResponse.status})")
+        }
+        if (keyResponse.body.size < 16) {
+            throw HlsDownloadException("HLS key was not 16 bytes")
+        }
+        val fetchedKey = keyResponse.body.copyOf(16)
+        keyMutex.withLock { keyCache[encryption.keyUrl] = fetchedKey }
+        fetchedKey
+    }
+
+    val iv = encryption.iv ?: hlsSequenceIv(sequenceNumber)
+    return decryptAes128Cbc(data, key, iv)
+}
+
+private suspend fun resolveMediaPlaylist(
+    sourceUrl: String,
+    httpGet: suspend (url: String, range: HlsByteRange?) -> HlsHttpResult,
+    ensureActive: () -> Unit,
+): ResolvedHlsMedia {
+    var currentUrl = sourceUrl
+    var declaredBitsPerSecond: Long? = null
+    repeat(MAX_PLAYLIST_REDIRECTS) {
+        ensureActive()
+        val response = httpGet(currentUrl, null)
+        if (response.status !in 200..299) {
+            throw HlsDownloadException("HLS playlist fetch failed (HTTP ${response.status})")
+        }
+        val baseUrl = response.finalUrl.ifBlank { currentUrl }
+        when (val parsed = parseHlsPlaylist(response.body.decodeToString(), baseUrl)) {
+            is HlsPlaylist.Media -> return ResolvedHlsMedia(parsed.playlist, declaredBitsPerSecond)
+            is HlsPlaylist.Master -> {
+                val variant = parsed.variants.maxByOrNull { it.bandwidth }
+                    ?: throw HlsDownloadException("HLS master playlist contained no variants")
+                declaredBitsPerSecond = (variant.averageBandwidth ?: variant.bandwidth)
+                    .takeIf { it > 0L }
+                currentUrl = variant.url
+            }
+        }
+    }
+    throw HlsDownloadException("HLS playlist nested too deeply")
+}
+
+internal fun declaredTotalBytes(bitsPerSecond: Long?, totalDuration: Double): Long? {
+    if (bitsPerSecond == null || bitsPerSecond <= 0L || totalDuration <= 0.0) return null
+    return (bitsPerSecond.toDouble() / 8.0 * totalDuration).toLong().takeIf { it > 0L }
+}
+
+internal fun hlsOutputFileName(baseFileName: String, isFmp4: Boolean): String {
+    val extension = if (isFmp4) "mp4" else "ts"
+    val dotIndex = baseFileName.lastIndexOf('.')
+    val stem = if (dotIndex > 0) baseFileName.substring(0, dotIndex) else baseFileName
+    return "$stem.$extension"
+}
+
+internal fun hlsCompanionFileName(baseFileName: String, suffix: String, extension: String): String {
+    val dotIndex = baseFileName.lastIndexOf('.')
+    val stem = if (dotIndex > 0) baseFileName.substring(0, dotIndex) else baseFileName
+    return "${stem}_$suffix.$extension"
+}
