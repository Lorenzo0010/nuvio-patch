index 0000000..608614d
--- /dev/null
+++ b/composeApp/src/androidMain/res/layout/widget_nuvio_compact.xml
@@ -0,0 +1,127 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/widget_background"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:paddingStart="12dp"
+    android:paddingTop="6dp"
+    android:paddingEnd="12dp"
+    android:paddingBottom="6dp">
+
+    <!-- Sezione Riproduzione / Continua a guardare -->
+    <LinearLayout
+        android:id="@+id/item_container_1"
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:clickable="true"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <!-- Miniatura Cover 16:9 -->
+        <FrameLayout
+            android:layout_width="60dp"
+            android:layout_height="36dp"
+            android:background="@drawable/widget_card_bg">
+
+            <ImageView
+                android:id="@+id/poster_1"
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:scaleType="centerCrop"
+                android:src="@drawable/ic_widget_poster_placeholder" />
+        </FrameLayout>
+
+        <!-- Titoli -->
+        <LinearLayout
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="8dp"
+            android:layout_weight="1"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/title_1"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:maxLines="1"
+                android:text="Nuvio Plus"
+                android:textColor="#FFFFFF"
+                android:textSize="12sp"
+                android:textStyle="bold" />
+
+            <TextView
+                android:id="@+id/subtitle_1"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="1dp"
+                android:ellipsize="end"
+                android:maxLines="1"
+                android:text="Continua a guardare"
+                android:textColor="#8E8E93"
+                android:textSize="10sp" />
+        </LinearLayout>
+    </LinearLayout>
+
+    <!-- Separatore verticale -->
+    <View
+        android:layout_width="1dp"
+        android:layout_height="28dp"
+        android:layout_marginStart="6dp"
+        android:layout_marginEnd="6dp"
+        android:background="#2C2C2E" />
+
+    <!-- Sezione Scorciatoie: Cerca, Live TV, Libreria, Offline -->
+    <LinearLayout
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <ImageButton
+            android:id="@+id/btn_search"
+            android:layout_width="32dp"
+            android:layout_height="32dp"
+            android:background="@drawable/widget_nav_button_bg"
+            android:contentDescription="@string/widget_nav_search"
+            android:padding="6dp"
+            android:scaleType="fitCenter"
+            android:src="@drawable/ic_widget_search" />
+
+        <ImageButton
+            android:id="@+id/btn_livetv"
+            android:layout_width="32dp"
+            android:layout_height="32dp"
+            android:layout_marginStart="4dp"
+            android:background="@drawable/widget_nav_button_bg"
+            android:contentDescription="@string/widget_nav_livetv"
+            android:padding="6dp"
+            android:scaleType="fitCenter"
+            android:src="@drawable/ic_widget_livetv" />
+
+        <ImageButton
+            android:id="@+id/btn_library"
+            android:layout_width="32dp"
+            android:layout_height="32dp"
+            android:layout_marginStart="4dp"
+            android:background="@drawable/widget_nav_button_bg"
+            android:contentDescription="@string/widget_nav_library"
+            android:padding="6dp"
+            android:scaleType="fitCenter"
+            android:src="@drawable/ic_widget_library" />
+
+        <ImageButton
+            android:id="@+id/btn_offline"
+            android:layout_width="32dp"
+            android:layout_height="32dp"
+            android:layout_marginStart="4dp"
+            android:background="@drawable/widget_nav_button_bg"
+            android:contentDescription="@string/widget_nav_offline"
+            android:padding="6dp"
+            android:scaleType="fitCenter"
+            android:src="@drawable/ic_widget_download" />
+    </LinearLayout>
+</LinearLayout>
