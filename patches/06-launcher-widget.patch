@@ -0,0 +1,451 @@
+package com.nuvio.app.widget
+
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.util.SizeF
+import android.view.View
+import android.widget.RemoteViews
+import com.nuvio.app.R
+import com.nuvio.app.features.watchprogress.WatchProgressEntry
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+
+class NuvioAppWidgetProvider : AppWidgetProvider() {
+
+    private val providerScope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
+
+    override fun onUpdate(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetIds: IntArray,
+    ) {
+        super.onUpdate(context, appWidgetManager, appWidgetIds)
+        updateAllWidgets(context, appWidgetManager, appWidgetIds)
+    }
+
+    override fun onAppWidgetOptionsChanged(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetId: Int,
+        newOptions: Bundle,
+    ) {
+        super.onAppWidgetOptionsChanged(context, appWidgetManager, appWidgetId, newOptions)
+        val pendingResult = goAsync()
+        providerScope.launch {
+            try {
+                val items = NuvioWidgetDataHelper.loadContinueWatchingItems(context, 10)
+                updateSingleWidget(context, appWidgetManager, appWidgetId, newOptions, items)
+            } finally {
+                pendingResult.finish()
+            }
+        }
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        val action = intent.action
+        if (action == ACTION_UPDATE_WIDGET || action == AppWidgetManager.ACTION_APPWIDGET_UPDATE) {
+            val appWidgetManager = AppWidgetManager.getInstance(context) ?: return
+            val component = ComponentName(context, NuvioAppWidgetProvider::class.java)
+            val ids = appWidgetManager.getAppWidgetIds(component)
+            if (ids != null && ids.isNotEmpty()) {
+                updateAllWidgets(context, appWidgetManager, ids)
+            }
+        }
+    }
+
+    private fun updateAllWidgets(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetIds: IntArray,
+    ) {
+        val pendingResult = goAsync()
+        providerScope.launch {
+            try {
+                val items = NuvioWidgetDataHelper.loadContinueWatchingItems(context, 10)
+                for (id in appWidgetIds) {
+                    val options = appWidgetManager.getAppWidgetOptions(id) ?: Bundle.EMPTY
+                    updateSingleWidget(context, appWidgetManager, id, options, items)
+                }
+            } finally {
+                pendingResult.finish()
+            }
+        }
+    }
+
+    private suspend fun updateSingleWidget(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetId: Int,
+        options: Bundle,
+        items: List<WatchProgressEntry>,
+    ) {
+        val remoteViews = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            val viewsMap = mutableMapOf<SizeF, RemoteViews>()
+            // 4x1 (compatto 1 riga con scorciatoie)
+            viewsMap[SizeF(180f, 40f)] = buildCompactViews(context, items)
+            // 2x2 (Apple TV Piccolo)
+            viewsMap[SizeF(110f, 110f)] = buildSingleViews(context, items.firstOrNull())
+            // 4x2 (Apple TV Medio)
+            viewsMap[SizeF(220f, 110f)] = buildMediumViews(context, items)
+            // 2x4 (Google TV Alto)
+            viewsMap[SizeF(110f, 220f)] = buildTallViews(context, items)
+            // 4x4 (Apple TV Grande)
+            viewsMap[SizeF(220f, 220f)] = buildLargeViews(context, items)
+
+            RemoteViews(viewsMap)
+        } else {
+            val minWidth = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH, 200)
+            val minHeight = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_HEIGHT, 100)
+
+            when {
+                minHeight < 80 -> buildCompactViews(context, items)
+                minWidth <= 160 && minHeight >= 200 -> buildTallViews(context, items)
+                minWidth <= 160 -> buildSingleViews(context, items.firstOrNull())
+                minHeight >= 200 -> buildLargeViews(context, items)
+                else -> buildMediumViews(context, items)
+            }
+        }
+
+        appWidgetManager.updateAppWidget(appWidgetId, remoteViews)
+    }
+
+    /**
+     * Apple TV Piccolo (2x2) - Immagine 0
+     * Singola card 16:9 con logo Nuvio in alto a destra, titolo e sottotitolo (es. S1, E2).
+     */
+    private suspend fun buildSingleViews(
+        context: Context,
+        item: WatchProgressEntry?,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_single)
+
+        if (item != null) {
+            views.setTextViewText(R.id.title_1, item.title)
+            views.setTextViewText(R.id.subtitle_1, NuvioWidgetDataHelper.formatSubtitle(item))
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForMeta(context, item, requestCode = 205),
+            )
+
+            val backdropUrl = NuvioWidgetDataHelper.resolveBackdropUrl(item)
+            val bitmap = NuvioWidgetDataHelper.loadBackdropBitmap(
+                context,
+                backdropUrl,
+                targetWidth = 320,
+                targetHeight = 180,
+                cornerRadiusDp = 12f,
+            )
+            if (bitmap != null) {
+                views.setImageViewBitmap(R.id.poster_1, bitmap)
+            } else {
+                views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            }
+        } else {
+            views.setTextViewText(R.id.title_1, "Nuvio Plus")
+            views.setTextViewText(R.id.subtitle_1, "Nessun video in corso")
+            views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://library", requestCode = 206),
+            )
+        }
+
+        return views
+    }
+
+    /**
+     * Apple TV Medio (4x2) - Immagine 1
+     * 2 schede 16:9 affiancate con titoli e sottotitoli separati, logo Nuvio in alto a destra.
+     */
+    private suspend fun buildMediumViews(
+        context: Context,
+        items: List<WatchProgressEntry>,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_medium)
+
+        // Slot 1
+        if (items.isNotEmpty()) {
+            val first = items[0]
+            views.setViewVisibility(R.id.slot_1, View.VISIBLE)
+            views.setTextViewText(R.id.title_1, first.title)
+            views.setTextViewText(R.id.subtitle_1, NuvioWidgetDataHelper.formatSubtitle(first))
+            views.setOnClickPendingIntent(
+                R.id.slot_1,
+                NuvioWidgetDataHelper.createPendingIntentForMeta(context, first, requestCode = 310),
+            )
+
+            val backdropUrl = NuvioWidgetDataHelper.resolveBackdropUrl(first)
+            val bitmap = NuvioWidgetDataHelper.loadBackdropBitmap(
+                context,
+                backdropUrl,
+                targetWidth = 300,
+                targetHeight = 170,
+                cornerRadiusDp = 12f,
+            )
+            if (bitmap != null) {
+                views.setImageViewBitmap(R.id.poster_1, bitmap)
+            } else {
+                views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            }
+        } else {
+            views.setViewVisibility(R.id.slot_1, View.VISIBLE)
+            views.setTextViewText(R.id.title_1, "Nuvio Plus")
+            views.setTextViewText(R.id.subtitle_1, "Nessun video in corso")
+            views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            views.setOnClickPendingIntent(
+                R.id.slot_1,
+                NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://library", requestCode = 311),
+            )
+        }
+
+        // Slot 2
+        if (items.size > 1) {
+            val second = items[1]
+            views.setViewVisibility(R.id.slot_2, View.VISIBLE)
+            views.setTextViewText(R.id.title_2, second.title)
+            views.setTextViewText(R.id.subtitle_2, NuvioWidgetDataHelper.formatSubtitle(second))
+            views.setOnClickPendingIntent(
+                R.id.slot_2,
+                NuvioWidgetDataHelper.createPendingIntentForMeta(context, second, requestCode = 312),
+            )
+
+            val backdropUrl = NuvioWidgetDataHelper.resolveBackdropUrl(second)
+            val bitmap = NuvioWidgetDataHelper.loadBackdropBitmap(
+                context,
+                backdropUrl,
+                targetWidth = 300,
+                targetHeight = 170,
+                cornerRadiusDp = 12f,
+            )
+            if (bitmap != null) {
+                views.setImageViewBitmap(R.id.poster_2, bitmap)
+            } else {
+                views.setImageViewResource(R.id.poster_2, R.drawable.ic_widget_poster_placeholder)
+            }
+        } else {
+            views.setViewVisibility(R.id.slot_2, View.INVISIBLE)
+        }
+
+        return views
+    }
+
+    /**
+     * Google TV Alto (2x4) - Immagine 2
+     * Header superiore con Cerca, Logo Nuvio e Live TV, seguito da 3 card 16:9 verticali.
+     */
+    private suspend fun buildTallViews(
+        context: Context,
+        items: List<WatchProgressEntry>,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_tall)
+
+        // Header pulsanti
+        views.setOnClickPendingIntent(
+            R.id.btn_search,
+            NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://search", requestCode = 501),
+        )
+        views.setOnClickPendingIntent(
+            R.id.btn_livetv,
+            NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://livetv", requestCode = 502),
+        )
+
+        val slotIds = listOf(R.id.slot_1, R.id.slot_2, R.id.slot_3)
+        val posterIds = listOf(R.id.poster_1, R.id.poster_2, R.id.poster_3)
+        val titleIds = listOf(R.id.title_1, R.id.title_2, R.id.title_3)
+        val subtitleIds = listOf(R.id.subtitle_1, R.id.subtitle_2, R.id.subtitle_3)
+
+        for (i in 0 until 3) {
+            val slot = slotIds[i]
+            if (i < items.size) {
+                val item = items[i]
+                views.setViewVisibility(slot, View.VISIBLE)
+                views.setTextViewText(titleIds[i], item.title)
+                views.setTextViewText(subtitleIds[i], NuvioWidgetDataHelper.formatSubtitle(item))
+                views.setOnClickPendingIntent(
+                    slot,
+                    NuvioWidgetDataHelper.createPendingIntentForMeta(context, item, requestCode = 510 + i),
+                )
+
+                val backdropUrl = NuvioWidgetDataHelper.resolveBackdropUrl(item)
+                val bitmap = NuvioWidgetDataHelper.loadBackdropBitmap(
+                    context,
+                    backdropUrl,
+                    targetWidth = 320,
+                    targetHeight = 180,
+                    cornerRadiusDp = 12f,
+                )
+                if (bitmap != null) {
+                    views.setImageViewBitmap(posterIds[i], bitmap)
+                } else {
+                    views.setImageViewResource(posterIds[i], R.drawable.ic_widget_poster_placeholder)
+                }
+            } else {
+                if (i == 0) {
+                    views.setViewVisibility(slot, View.VISIBLE)
+                    views.setTextViewText(titleIds[0], "Nuvio Plus")
+                    views.setTextViewText(subtitleIds[0], "Nessun video in corso")
+                    views.setImageViewResource(posterIds[0], R.drawable.ic_widget_poster_placeholder)
+                    views.setOnClickPendingIntent(
+                        slot,
+                        NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://library", requestCode = 515),
+                    )
+                } else {
+                    views.setViewVisibility(slot, View.INVISIBLE)
+                }
+            }
+        }
+
+        return views
+    }
+
+    /**
+     * Apple TV Grande (4x4) - Immagine 3
+     * Elemento in primo piano in alto (backdrop grande) + lista orizzontale a 2 righe in basso.
+     */
+    private suspend fun buildLargeViews(
+        context: Context,
+        items: List<WatchProgressEntry>,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_large)
+
+        // Elemento in primo piano (Slot 1)
+        if (items.isNotEmpty()) {
+            val featured = items[0]
+            views.setViewVisibility(R.id.slot_1, View.VISIBLE)
+            views.setTextViewText(R.id.title_1, featured.title)
+            views.setTextViewText(R.id.subtitle_1, NuvioWidgetDataHelper.formatFeaturedSubtitle(featured))
+            views.setOnClickPendingIntent(
+                R.id.slot_1,
+                NuvioWidgetDataHelper.createPendingIntentForMeta(context, featured, requestCode = 410),
+            )
+
+            val backdropUrl = NuvioWidgetDataHelper.resolveBackdropUrl(featured)
+            val bitmap = NuvioWidgetDataHelper.loadBackdropBitmap(
+                context,
+                backdropUrl,
+                targetWidth = 500,
+                targetHeight = 280,
+                cornerRadiusDp = 12f,
+            )
+            if (bitmap != null) {
+                views.setImageViewBitmap(R.id.poster_1, bitmap)
+            } else {
+                views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            }
+        } else {
+            views.setViewVisibility(R.id.slot_1, View.VISIBLE)
+            views.setTextViewText(R.id.title_1, "Nuvio Plus")
+            views.setTextViewText(R.id.subtitle_1, "CONTINUA A GUARDARE")
+            views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            views.setOnClickPendingIntent(
+                R.id.slot_1,
+                NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://library", requestCode = 411),
+            )
+        }
+
+        // Righe inferiori (Slot 2 e 3)
+        val subSlots = listOf(R.id.slot_2, R.id.slot_3)
+        val subPosters = listOf(R.id.poster_2, R.id.poster_3)
+        val subTitles = listOf(R.id.title_2, R.id.title_3)
+        val subSubtitles = listOf(R.id.subtitle_2, R.id.subtitle_3)
+
+        for (i in 0..1) {
+            val itemIndex = i + 1
+            val slot = subSlots[i]
+            if (itemIndex < items.size) {
+                val item = items[itemIndex]
+                views.setViewVisibility(slot, View.VISIBLE)
+                views.setTextViewText(subTitles[i], item.title)
+                views.setTextViewText(subSubtitles[i], NuvioWidgetDataHelper.formatSubtitle(item))
+                views.setOnClickPendingIntent(
+                    slot,
+                    NuvioWidgetDataHelper.createPendingIntentForMeta(context, item, requestCode = 420 + i),
+                )
+
+                val backdropUrl = NuvioWidgetDataHelper.resolveBackdropUrl(item)
+                val bitmap = NuvioWidgetDataHelper.loadBackdropBitmap(
+                    context,
+                    backdropUrl,
+                    targetWidth = 160,
+                    targetHeight = 90,
+                    cornerRadiusDp = 8f,
+                )
+                if (bitmap != null) {
+                    views.setImageViewBitmap(subPosters[i], bitmap)
+                } else {
+                    views.setImageViewResource(subPosters[i], R.drawable.ic_widget_poster_placeholder)
+                }
+            } else {
+                views.setViewVisibility(slot, View.INVISIBLE)
+            }
+        }
+
+        return views
+    }
+
+    /**
+     * Fallback compatto (1 riga) per il widget continua a guardare ridimensionato al minimo.
+     */
+    private suspend fun buildCompactViews(
+        context: Context,
+        items: List<WatchProgressEntry>,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_compact)
+        NuvioWidgetDataHelper.bindNavigationButtons(context, views, baseRequestCode = 100)
+
+        val first = items.firstOrNull()
+        if (first != null) {
+            views.setTextViewText(R.id.title_1, first.title)
+            views.setTextViewText(R.id.subtitle_1, NuvioWidgetDataHelper.formatSubtitle(first))
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForMeta(context, first, requestCode = 105),
+            )
+
+            val backdropUrl = NuvioWidgetDataHelper.resolveBackdropUrl(first)
+            val bitmap = NuvioWidgetDataHelper.loadBackdropBitmap(
+                context,
+                backdropUrl,
+                targetWidth = 140,
+                targetHeight = 84,
+                cornerRadiusDp = 8f,
+            )
+            if (bitmap != null) {
+                views.setImageViewBitmap(R.id.poster_1, bitmap)
+            } else {
+                views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            }
+        } else {
+            views.setTextViewText(R.id.title_1, "Nuvio Plus")
+            views.setTextViewText(R.id.subtitle_1, "Nessun video in corso")
+            views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://library", requestCode = 106),
+            )
+        }
+
+        return views
+    }
+
+    companion object {
+        const val ACTION_UPDATE_WIDGET = "com.nuvio.app.widget.ACTION_UPDATE_WIDGET"
+
+        fun notifyDataChanged(context: Context) {
+            runCatching {
+                val intent = Intent(ACTION_UPDATE_WIDGET).apply {
+                    setPackage(context.packageName)
+                }
+                context.sendBroadcast(intent)
+            }
+        }
+    }
+}
