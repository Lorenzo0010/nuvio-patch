+                    views.setProgressBar(progressIds[slotIndex], 100, NuvioWidgetDataHelper.formatProgressPercent(item), false)
+                    views.setOnClickPendingIntent(
+                        slot,
+                        NuvioWidgetDataHelper.createPendingIntentForMeta(context, item, requestCode = 510 + slotIndex),
