+package com.nuvio.app.widget
+
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.util.SizeF
+import android.view.View
+import android.widget.RemoteViews
+import com.nuvio.app.R
+import com.nuvio.app.features.watchprogress.WatchProgressEntry
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+
+class NuvioAppWidgetProvider : AppWidgetProvider() {
+
+    private val providerScope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
+
+    override fun onUpdate(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetIds: IntArray,
+    ) {
+        super.onUpdate(context, appWidgetManager, appWidgetIds)
+        updateAllWidgets(context, appWidgetManager, appWidgetIds)
+    }
+
+    override fun onAppWidgetOptionsChanged(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetId: Int,
+        newOptions: Bundle,
+    ) {
+        super.onAppWidgetOptionsChanged(context, appWidgetManager, appWidgetId, newOptions)
+        val pendingResult = goAsync()
+        providerScope.launch {
+            try {
+                val items = NuvioWidgetDataHelper.loadContinueWatchingItems(context, 15)
+                updateSingleWidget(context, appWidgetManager, appWidgetId, newOptions, items)
+            } finally {
+                pendingResult.finish()
+            }
+        }
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        val action = intent.action
+        if (action == ACTION_UPDATE_WIDGET || action == AppWidgetManager.ACTION_APPWIDGET_UPDATE) {
+            val appWidgetManager = AppWidgetManager.getInstance(context) ?: return
+            val component = ComponentName(context, NuvioAppWidgetProvider::class.java)
+            val ids = appWidgetManager.getAppWidgetIds(component)
+            if (ids != null && ids.isNotEmpty()) {
+                updateAllWidgets(context, appWidgetManager, ids)
+            }
+        }
+    }
+
+    private fun updateAllWidgets(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetIds: IntArray,
+    ) {
+        val pendingResult = goAsync()
+        providerScope.launch {
+            try {
+                val items = NuvioWidgetDataHelper.loadContinueWatchingItems(context, 15)
+                for (id in appWidgetIds) {
+                    val options = appWidgetManager.getAppWidgetOptions(id) ?: Bundle.EMPTY
+                    updateSingleWidget(context, appWidgetManager, id, options, items)
+                }
+            } finally {
+                pendingResult.finish()
+            }
+        }
+    }
+
+    private suspend fun updateSingleWidget(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetId: Int,
+        options: Bundle,
+        items: List<WatchProgressEntry>,
+    ) {
+        val remoteViews = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            val viewsMap = mutableMapOf<SizeF, RemoteViews>()
+            // 2x1 (110dp x 45dp)
+            viewsMap[SizeF(110f, 45f)] = buildCompactViews(context, items, isWide = false)
+            // 3x1..5x1 (220dp x 45dp)
+            viewsMap[SizeF(220f, 45f)] = buildCompactViews(context, items, isWide = true)
+            // 2x2 (110dp x 110dp)
+            viewsMap[SizeF(110f, 110f)] = buildSingleViews(context, items.firstOrNull())
+            // 3x2, 4x2 (220dp x 110dp) -> 3 items
+            viewsMap[SizeF(220f, 110f)] = buildMediumViews(context, items, maxColumns = 3)
+            // 5x2 (340dp x 110dp) -> 4 items
+            viewsMap[SizeF(340f, 110f)] = buildMediumViews(context, items, maxColumns = 4)
+            // 4x4 (220dp x 200dp) -> 2x3 (6 items)
+            viewsMap[SizeF(220f, 200f)] = buildLargeViews(context, items, maxColumns = 3)
+            // 5x4 (340dp x 200dp) -> 2x5 (10 items)
+            viewsMap[SizeF(340f, 200f)] = buildLargeViews(context, items, maxColumns = 5)
+            // 4x6 (220dp x 320dp) -> 3x3 (9 items)
+            viewsMap[SizeF(220f, 320f)] = buildTallViews(context, items, maxColumns = 3)
+            // 5x6 (340dp x 320dp) -> 3x5 (15 items)
+            viewsMap[SizeF(340f, 320f)] = buildTallViews(context, items, maxColumns = 5)
+
+            RemoteViews(viewsMap)
+        } else {
+            val minWidth = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH, 200)
+            val minHeight = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_HEIGHT, 100)
+
+            when {
+                minHeight >= 300 -> buildTallViews(context, items, maxColumns = if (minWidth >= 320) 5 else 3)
+                minHeight >= 180 -> buildLargeViews(context, items, maxColumns = if (minWidth >= 320) 5 else 3)
+                minWidth <= 150 && minHeight >= 100 -> buildSingleViews(context, items.firstOrNull())
+                minHeight >= 90 -> buildMediumViews(context, items, maxColumns = if (minWidth >= 320) 4 else 3)
+                else -> buildCompactViews(context, items, isWide = minWidth >= 200)
+            }
+        }
+
+        appWidgetManager.updateAppWidget(appWidgetId, remoteViews)
+    }
+
+    private suspend fun buildCompactViews(
+        context: Context,
+        items: List<WatchProgressEntry>,
+        isWide: Boolean,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_compact)
+        NuvioWidgetDataHelper.bindNavigationButtons(context, views, baseRequestCode = 100)
+
+        val first = items.firstOrNull()
+        if (first != null) {
+            views.setTextViewText(R.id.title_1, first.title)
+            views.setTextViewText(R.id.subtitle_1, NuvioWidgetDataHelper.formatSubtitle(first))
+            views.setProgressBar(R.id.progress_1, 100, NuvioWidgetDataHelper.formatProgressPercent(first), false)
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForMeta(context, first, requestCode = 105),
+            )
+
+            val posterUrl = first.poster ?: first.episodeThumbnail ?: first.background
+            val bitmap = NuvioWidgetDataHelper.loadPosterBitmap(context, posterUrl, targetWidth = 100, targetHeight = 100, cornerRadiusDp = 6f)
+            if (bitmap != null) {
+                views.setImageViewBitmap(R.id.poster_1, bitmap)
+            } else {
+                views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            }
+        } else {
+            views.setTextViewText(R.id.title_1, "Nuvio Plus")
+            views.setTextViewText(R.id.subtitle_1, "Nessun video in corso")
+            views.setProgressBar(R.id.progress_1, 100, 0, false)
+            views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://library", requestCode = 106),
+            )
+        }
+
+        return views
+    }
+
+    private suspend fun buildSingleViews(
+        context: Context,
+        item: WatchProgressEntry?,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_single)
+        NuvioWidgetDataHelper.bindNavigationButtons(context, views, baseRequestCode = 200)
+
+        if (item != null) {
+            views.setTextViewText(R.id.title_1, item.title)
+            views.setTextViewText(R.id.subtitle_1, NuvioWidgetDataHelper.formatSubtitle(item))
+            views.setProgressBar(R.id.progress_1, 100, NuvioWidgetDataHelper.formatProgressPercent(item), false)
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForMeta(context, item, requestCode = 205),
+            )
+
+            val posterUrl = item.poster ?: item.episodeThumbnail ?: item.background
+            val bitmap = NuvioWidgetDataHelper.loadPosterBitmap(context, posterUrl, targetWidth = 160, targetHeight = 240, cornerRadiusDp = 8f)
+            if (bitmap != null) {
+                views.setImageViewBitmap(R.id.poster_1, bitmap)
+            } else {
+                views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            }
+        } else {
+            views.setTextViewText(R.id.title_1, "Nuvio Plus")
+            views.setTextViewText(R.id.subtitle_1, "Nessun video")
+            views.setProgressBar(R.id.progress_1, 100, 0, false)
+            views.setImageViewResource(R.id.poster_1, R.drawable.ic_widget_poster_placeholder)
+            views.setOnClickPendingIntent(
+                R.id.item_container_1,
+                NuvioWidgetDataHelper.createPendingIntentForDeepLink(context, "nuvio://library", requestCode = 206),
+            )
+        }
+
+        return views
+    }
+
+    private suspend fun buildMediumViews(
+        context: Context,
+        items: List<WatchProgressEntry>,
+        maxColumns: Int,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_medium)
+        NuvioWidgetDataHelper.bindNavigationButtons(context, views, baseRequestCode = 300)
+
+        val slotIds = listOf(R.id.slot_1, R.id.slot_2, R.id.slot_3, R.id.slot_4)
+        val posterIds = listOf(R.id.poster_1, R.id.poster_2, R.id.poster_3, R.id.poster_4)
+        val progressIds = listOf(R.id.progress_1, R.id.progress_2, R.id.progress_3, R.id.progress_4)
+        val titleIds = listOf(R.id.title_1, R.id.title_2, R.id.title_3, R.id.title_4)
+        val subtitleIds = listOf(R.id.subtitle_1, R.id.subtitle_2, R.id.subtitle_3, R.id.subtitle_4)
+
+        for (i in 0 until 4) {
+            val slot = slotIds[i]
+            if (i >= maxColumns) {
+                views.setViewVisibility(slot, View.GONE)
+                continue
+            }
+
+            if (i < items.size) {
+                val item = items[i]
+                views.setViewVisibility(slot, View.VISIBLE)
+                views.setTextViewText(titleIds[i], item.title)
+                views.setTextViewText(subtitleIds[i], NuvioWidgetDataHelper.formatSubtitle(item))
+                views.setProgressBar(progressIds[i], 100, NuvioWidgetDataHelper.formatProgressPercent(item), false)
+                views.setOnClickPendingIntent(
+                    slot,
+                    NuvioWidgetDataHelper.createPendingIntentForMeta(context, item, requestCode = 310 + i),
+                )
+
+                val posterUrl = item.poster ?: item.episodeThumbnail ?: item.background
+                val bitmap = NuvioWidgetDataHelper.loadPosterBitmap(context, posterUrl, targetWidth = 140, targetHeight = 210, cornerRadiusDp = 8f)
+                if (bitmap != null) {
+                    views.setImageViewBitmap(posterIds[i], bitmap)
+                } else {
+                    views.setImageViewResource(posterIds[i], R.drawable.ic_widget_poster_placeholder)
+                }
+            } else {
+                if (i == 0) {
+                    views.setViewVisibility(slot, View.VISIBLE)
+                    views.setTextViewText(titleIds[0], "Nuvio")
+                    views.setTextViewText(subtitleIds[0], "Nessun video")
+                    views.setProgressBar(progressIds[0], 100, 0, false)
+                    views.setImageViewResource(posterIds[0], R.drawable.ic_widget_poster_placeholder)
+                } else {
+                    views.setViewVisibility(slot, View.INVISIBLE)
+                }
+            }
+        }
+
+        return views
+    }
+
+    private suspend fun buildLargeViews(
+        context: Context,
+        items: List<WatchProgressEntry>,
+        maxColumns: Int,
+    ): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_large)
+        NuvioWidgetDataHelper.bindNavigationButtons(context, views, baseRequestCode = 400)
+
+        val slotIds = listOf(
+            R.id.slot_1, R.id.slot_2, R.id.slot_3, R.id.slot_4, R.id.slot_5,
+            R.id.slot_6, R.id.slot_7, R.id.slot_8, R.id.slot_9, R.id.slot_10,
+        )
+        val posterIds = listOf(
+            R.id.poster_1, R.id.poster_2, R.id.poster_3, R.id.poster_4, R.id.poster_5,
+            R.id.poster_6, R.id.poster_7, R.id.poster_8, R.id.poster_9, R.id.poster_10,
+        )
+        val progressIds = listOf(
+            R.id.progress_1, R.id.progress_2, R.id.progress_3, R.id.progress_4, R.id.progress_5,
+            R.id.progress_6, R.id.progress_7, R.id.progress_8, R.id.progress_9, R.id.progress_10,
+        )
+        val titleIds = listOf(
+            R.id.title_1, R.id.title_2, R.id.title_3, R.id.title_4, R.id.title_5,
+            R.id.title_6, R.id.title_7, R.id.title_8, R.id.title_9, R.id.title_10,
+        )
+
+        var itemIndex = 0
+        for (row in 0..1) {
+            for (col in 0..4) {
+                val slotIndex = row * 5 + col
+                val slot = slotIds[slotIndex]
+
+                if (col >= maxColumns) {
+                    views.setViewVisibility(slot, View.GONE)
+                    continue
+                }
+
+                if (itemIndex < items.size) {
+                    val item = items[itemIndex]
+                    views.setViewVisibility(slot, View.VISIBLE)
+                    views.setTextViewText(titleIds[slotIndex], item.title)
+                    views.setProgressBar(progressIds[slotIndex], 100, NuvioWidgetDataHelper.formatProgressPercent(item), false)
+                    views.setOnClickPendingIntent(
+                        slot,
+                        NuvioWidgetDataHelper.createPendingIntentForMeta(context, item, requestCode = 410 + slotIndex),
+                    )
+
+                    val posterUrl = item.poster ?: item.episodeThumbnail ?: item.background
+                    val bitmap = NuvioWidgetDataHelper.loadPosterBitmap(context, posterUrl, targetWidth = 120, targetHeight = 180, cornerRadiusDp = 6f)
+                    if (bitmap != null) {
+                        views.setImageViewBitmap(posterIds[slotIndex], bitmap)
+                    } else {
+                        views.setImageViewResource(posterIds[slotIndex], R.drawable.ic_widget_poster_placeholder)
+                    }
+                    itemIndex++
+                } else {
+                    if (itemIndex == 0 && slotIndex == 0) {
+                        views.setViewVisibility(slot, View.VISIBLE)
+                        views.setTextViewText(titleIds[0], "Nuvio")
+                        views.setProgressBar(progressIds[0], 100, 0, false)
+                        views.setImageViewResource(posterIds[0], R.drawable.ic_widget_poster_placeholder)
+                    } else {
+                        views.setViewVisibility(slot, View.INVISIBLE)
+                    }
+                }
+            }
+        }
+
+        return views
+    }
+
