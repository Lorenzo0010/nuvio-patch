+
+                    val posterUrl = item.poster ?: item.episodeThumbnail ?: item.background
+                    val bitmap = NuvioWidgetDataHelper.loadPosterBitmap(context, posterUrl, targetWidth = 100, targetHeight = 150, cornerRadiusDp = 6f)
+                    if (bitmap != null) {
