+package com.nuvio.app.widget
+
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.util.SizeF
+import android.widget.RemoteViews
+import com.nuvio.app.R
+
+class NuvioNavbarWidgetProvider : AppWidgetProvider() {
+
+    override fun onUpdate(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetIds: IntArray,
+    ) {
+        super.onUpdate(context, appWidgetManager, appWidgetIds)
+        for (id in appWidgetIds) {
+            val options = appWidgetManager.getAppWidgetOptions(id) ?: Bundle.EMPTY
+            updateNavbarWidget(context, appWidgetManager, id, options)
+        }
+    }
+
+    override fun onAppWidgetOptionsChanged(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetId: Int,
+        newOptions: Bundle,
+    ) {
+        super.onAppWidgetOptionsChanged(context, appWidgetManager, appWidgetId, newOptions)
+        updateNavbarWidget(context, appWidgetManager, appWidgetId, newOptions)
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        val action = intent.action
+        if (action == ACTION_UPDATE_NAVBAR || action == AppWidgetManager.ACTION_APPWIDGET_UPDATE) {
+            val appWidgetManager = AppWidgetManager.getInstance(context) ?: return
+            val component = ComponentName(context, NuvioNavbarWidgetProvider::class.java)
+            val ids = appWidgetManager.getAppWidgetIds(component)
+            if (ids != null && ids.isNotEmpty()) {
+                for (id in ids) {
+                    val options = appWidgetManager.getAppWidgetOptions(id) ?: Bundle.EMPTY
+                    updateNavbarWidget(context, appWidgetManager, id, options)
+                }
+            }
+        }
+    }
+
+    private fun updateNavbarWidget(
+        context: Context,
+        appWidgetManager: AppWidgetManager,
+        appWidgetId: Int,
+        options: Bundle,
+    ) {
+        val remoteViews = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            val viewsMap = mutableMapOf<SizeF, RemoteViews>()
+            // Sotto i 50dp di altezza: versione solo icone compatta
+            viewsMap[SizeF(120f, 35f)] = buildCompactNavbarViews(context)
+            // Sopra i 50dp di altezza: versione con icone e diciture (Cerca, Live TV, Libreria, Offline)
+            viewsMap[SizeF(120f, 50f)] = buildStandardNavbarViews(context)
+            viewsMap[SizeF(240f, 50f)] = buildStandardNavbarViews(context)
+            RemoteViews(viewsMap)
+        } else {
+            val minHeight = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_HEIGHT, 50)
+            if (minHeight < 48) {
+                buildCompactNavbarViews(context)
+            } else {
+                buildStandardNavbarViews(context)
+            }
+        }
+
+        appWidgetManager.updateAppWidget(appWidgetId, remoteViews)
+    }
+
+    private fun buildStandardNavbarViews(context: Context): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_navbar)
+        NuvioWidgetDataHelper.bindNavbarWidgetButtons(context, views, baseRequestCode = 910)
+        return views
+    }
+
+    private fun buildCompactNavbarViews(context: Context): RemoteViews {
+        val views = RemoteViews(context.packageName, R.layout.widget_nuvio_navbar_compact)
+        NuvioWidgetDataHelper.bindNavbarWidgetButtons(context, views, baseRequestCode = 920)
+        return views
+    }
+
+    companion object {
+        const val ACTION_UPDATE_NAVBAR = "com.nuvio.app.widget.ACTION_UPDATE_NAVBAR"
+
+        fun notifyChanged(context: Context) {
+            runCatching {
+                val intent = Intent(ACTION_UPDATE_NAVBAR).apply {
+                    setPackage(context.packageName)
+                }
+                context.sendBroadcast(intent)
+            }
+        }
+    }
+}
diff --git a/composeApp/src/androidMain/kotlin/com/nuvio/app/widget/NuvioWidgetDataHelper.kt b/composeApp/src/androidMain/kotlin/com/nuvio/app/widget/NuvioWidgetDataHelper.kt
new file mode 100644
index 0000000..b6943a8
--- /dev/null
+++ b/composeApp/src/androidMain/kotlin/com/nuvio/app/widget/NuvioWidgetDataHelper.kt
@@ -0,0 +1,235 @@
+package com.nuvio.app.widget
+
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Matrix
+import android.graphics.Paint
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffXfermode
+import android.graphics.Rect
+import android.graphics.RectF
+import android.net.Uri
+import android.widget.RemoteViews
+import com.nuvio.app.MainActivity
+import com.nuvio.app.R
+import com.nuvio.app.features.watchprogress.WatchProgressCodec
+import com.nuvio.app.features.watchprogress.WatchProgressEntry
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.FileOutputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.MessageDigest
+
+internal object NuvioWidgetDataHelper {
+
+    private const val PREFS_WATCH_PROGRESS = "nuvio_watch_progress"
+    private const val KEY_PAYLOAD = "watch_progress_payload"
+    private const val KEY_LAST_ACTIVE_PROFILE = "last_active_profile_id"
+
+    fun loadContinueWatchingItems(context: Context, maxItems: Int = 10): List<WatchProgressEntry> {
+        val prefs = context.getSharedPreferences(PREFS_WATCH_PROGRESS, Context.MODE_PRIVATE)
+        val activeProfileId = prefs.getInt(KEY_LAST_ACTIVE_PROFILE, 0)
+
+        var payload = prefs.getString("${KEY_PAYLOAD}_$activeProfileId", null)
+        if (payload.isNullOrBlank()) {
+            val fallbackKey = prefs.all.keys.firstOrNull { it.startsWith(KEY_PAYLOAD) }
+            if (fallbackKey != null) {
+                payload = prefs.getString(fallbackKey, null)
+            }
+        }
+
+        if (payload.isNullOrBlank()) return emptyList()
+
+        return runCatching {
+            WatchProgressCodec.decodePayload(payload).entries
+                .filter { !it.isEffectivelyCompleted }
+                .take(maxItems)
+        }.getOrDefault(emptyList())
+    }
+
+    fun createPendingIntentForMeta(context: Context, entry: WatchProgressEntry, requestCode: Int): PendingIntent {
+        val intent = Intent(context, MainActivity::class.java).apply {
+            action = Intent.ACTION_VIEW
+            data = Uri.parse("nuvio://meta?type=${entry.parentMetaType.trim()}&id=${entry.parentMetaId.trim()}")
+            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+        }
+        return PendingIntent.getActivity(
+            context,
+            requestCode,
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+    }
+
+    fun createPendingIntentForDeepLink(context: Context, deepLinkUrl: String, requestCode: Int): PendingIntent {
+        val intent = Intent(context, MainActivity::class.java).apply {
+            action = Intent.ACTION_VIEW
+            data = Uri.parse(deepLinkUrl)
+            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+        }
+        return PendingIntent.getActivity(
+            context,
+            requestCode,
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+    }
+
+    fun bindNavigationButtons(context: Context, remoteViews: RemoteViews, baseRequestCode: Int) {
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_search,
+            createPendingIntentForDeepLink(context, "nuvio://search", baseRequestCode + 1),
+        )
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_livetv,
+            createPendingIntentForDeepLink(context, "nuvio://livetv", baseRequestCode + 2),
+        )
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_library,
+            createPendingIntentForDeepLink(context, "nuvio://library", baseRequestCode + 3),
+        )
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_offline,
+            createPendingIntentForDeepLink(context, "nuvio://downloads", baseRequestCode + 4),
+        )
+    }
+
+    fun bindNavbarWidgetButtons(context: Context, remoteViews: RemoteViews, baseRequestCode: Int) {
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_nav_search,
+            createPendingIntentForDeepLink(context, "nuvio://search", baseRequestCode + 1),
+        )
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_nav_livetv,
+            createPendingIntentForDeepLink(context, "nuvio://livetv", baseRequestCode + 2),
+        )
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_nav_library,
+            createPendingIntentForDeepLink(context, "nuvio://library", baseRequestCode + 3),
+        )
+        remoteViews.setOnClickPendingIntent(
+            R.id.btn_nav_offline,
+            createPendingIntentForDeepLink(context, "nuvio://downloads", baseRequestCode + 4),
+        )
+    }
+
+    fun resolveBackdropUrl(entry: WatchProgressEntry): String? {
+        return entry.episodeThumbnail ?: entry.background ?: entry.poster
+    }
+
+    fun formatSubtitle(entry: WatchProgressEntry): String {
+        return if (entry.isEpisode) {
+            val s = entry.seasonNumber ?: 1
+            val e = entry.episodeNumber ?: 1
+            "S%d, E%d".format(s, e)
+        } else {
+            val remainingMs = (entry.durationMs - entry.lastPositionMs).coerceAtLeast(0L)
+            if (remainingMs > 0L) {
+                val totalMin = remainingMs / 60000L
+                val h = totalMin / 60
+                val m = totalMin % 60
+                if (h > 0) "${h}h ${m}m rimanenti" else "${m}m rimanenti"
+            } else {
+                "Film"
+            }
+        }
+    }
+
+    fun formatFeaturedSubtitle(entry: WatchProgressEntry): String {
+        return if (entry.isEpisode) {
+            val s = entry.seasonNumber ?: 1
+            val e = entry.episodeNumber ?: 1
+            "CONTINUA ÔÇó S%d, E%d".format(s, e)
+        } else {
+            "CONTINUA"
+        }
+    }
+
+    suspend fun loadBackdropBitmap(
+        context: Context,
+        url: String?,
+        targetWidth: Int = 320,
+        targetHeight: Int = 180,
+        cornerRadiusDp: Float = 12f,
+    ): Bitmap? = withContext(Dispatchers.IO) {
+        if (url.isNullOrBlank()) return@withContext null
+        val cacheDir = File(context.cacheDir, "widget_posters").apply { mkdirs() }
+        val filename = "${hashUrl(url)}_${targetWidth}x${targetHeight}.png"
+        val cachedFile = File(cacheDir, filename)
+
+        if (cachedFile.exists() && cachedFile.length() > 0) {
+            val decoded = BitmapFactory.decodeFile(cachedFile.absolutePath)
+            if (decoded != null) {
+                return@withContext getRoundedCornerBitmap(context, decoded, cornerRadiusDp)
+            }
+        }
+
+        try {
+            val connection = URL(url).openConnection() as HttpURLConnection
+            connection.connectTimeout = 5000
+            connection.readTimeout = 5000
+            connection.instanceFollowRedirects = true
+            connection.connect()
+
+            if (connection.responseCode == HttpURLConnection.HTTP_OK) {
+                connection.inputStream.use { stream ->
+                    val rawBitmap = BitmapFactory.decodeStream(stream) ?: return@withContext null
+                    val cropped = createCenterCropBitmap(rawBitmap, targetWidth, targetHeight)
+                    FileOutputStream(cachedFile).use { out ->
+                        cropped.compress(Bitmap.CompressFormat.PNG, 90, out)
+                    }
+                    return@withContext getRoundedCornerBitmap(context, cropped, cornerRadiusDp)
+                }
+            }
+        } catch (_: Exception) {
+            // Ignored - fallback image will be shown
+        }
+        null
+    }
+
+    private fun createCenterCropBitmap(src: Bitmap, targetWidth: Int, targetHeight: Int): Bitmap {
+        val scale = maxOf(
+            targetWidth.toFloat() / src.width.toFloat(),
+            targetHeight.toFloat() / src.height.toFloat(),
+        )
+        val scaledWidth = scale * src.width
+        val scaledHeight = scale * src.height
+        val left = (targetWidth - scaledWidth) / 2f
+        val top = (targetHeight - scaledHeight) / 2f
+
+        val output = Bitmap.createBitmap(targetWidth, targetHeight, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(output)
+        val paint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG)
+        val matrix = Matrix().apply {
+            postScale(scale, scale)
+            postTranslate(left, top)
+        }
+        canvas.drawBitmap(src, matrix, paint)
+        return output
+    }
+
+    private fun getRoundedCornerBitmap(context: Context, bitmap: Bitmap, cornerRadiusDp: Float): Bitmap {
+        val output = Bitmap.createBitmap(bitmap.width, bitmap.height, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(output)
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        val rect = Rect(0, 0, bitmap.width, bitmap.height)
+        val rectF = RectF(rect)
+        val radiusPx = cornerRadiusDp * context.resources.displayMetrics.density
+
+        canvas.drawRoundRect(rectF, radiusPx, radiusPx, paint)
+        paint.xfermode = PorterDuffXfermode(PorterDuff.Mode.SRC_IN)
+        canvas.drawBitmap(bitmap, rect, rect, paint)
+        return output
+    }
+
+    private fun hashUrl(url: String): String {
+        val bytes = MessageDigest.getInstance("MD5").digest(url.toByteArray())
+        return bytes.joinToString("") { "%02x".format(it) }
+    }
+}
