+                (selectedLanguage == null || item.metadata.language == selectedLanguage) &&
+                (selectedType == null || selectedType in item.metadata.rawTvTypes)
+        }
+    }
+    val bulkActionPlugins = remember(visiblePlugins) {
+        visiblePlugins.filter { item ->
+            !item.isInstalling &&
