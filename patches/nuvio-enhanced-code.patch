-def mix_hex(first, second, amount):
-    a = np.array(hex_rgb(first), dtype=np.float32)
-    b = np.array(hex_rgb(second), dtype=np.float32)
-    return tuple(np.rint(a * (1 - amount) + b * amount).astype(np.uint8))
-
