+    }
+
+    if (isSheetVisible) {
+        LiveTvCategoryOptionsSheet(
+            title = categoryTitle,
+            groups = groups,
+            selectedGroup = selectedGroup,
+            sheetState = sheetState,
+            onDismiss = {
