+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+private fun DiscoverPosterTile(
+    item: MetaPreview,
+    cornerRadiusDp: Int,
+    hideLabels: Boolean,
+    modifier: Modifier = Modifier,
