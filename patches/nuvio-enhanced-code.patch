+const sourceKeyForItems = items => {
+  const first = items[0] || {};
+  const last = items[items.length - 1] || {};
+  return [
+    sourceFilterId || "",
+    items.length,
+    first.index == null ? "" : first.index,
+    first.label || "",
+    last.index == null ? "" : last.index,
+    last.label || "",
