+internal fun LazyListScope.patchesPlusSettingsContent(
+    isTablet: Boolean,
+    preloadStreams: Boolean,
+    onPreloadStreamsToggle: (Boolean) -> Unit,
+) {
+    item {
+        SettingsSection(
+            title = stringResource(Res.string.settings_patches_plus_playback_section),
+            isTablet = isTablet,
+        ) {
+            SettingsGroup(isTablet = isTablet) {
+                SettingsSwitchRow(
+                    title = stringResource(Res.string.settings_meta_preload_streams),
+                    description = stringResource(Res.string.settings_meta_preload_streams_description),
+                    checked = preloadStreams,
+                    isTablet = isTablet,
+                    onCheckedChange = onPreloadStreamsToggle,
+                )
+            }
+        }
+    }
+}
