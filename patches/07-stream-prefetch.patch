+    BasicAlertDialog(onDismissRequest = onDismiss) {
+        PlusDialogSurface(title = "Filtro Addon") {
+            Text(
+                text = "Seleziona un addon specifico oppure consenti la ricerca su tutti gli addon attivi:",
+                style = MaterialTheme.typography.bodyMedium,
+                color = tokens.colors.textSecondary,
+            )
+
+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .clickable { onAddonSelected(null) }
+                    .padding(vertical = NuvioTokens.Space.s6),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(tokens.spacing.controlGap),
+            ) {
+                RadioButton(
+                    selected = selectedAddonId.isNullOrBlank(),
+                    onClick = { onAddonSelected(null) },
+                )
+                Text(
+                    text = "Tutti gli addon",
+                    style = MaterialTheme.typography.bodyLarge,
+                    color = tokens.colors.textPrimary,
+                )
+            }
+
+            addons.forEach { (id, name) ->
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable { onAddonSelected(id) }
+                        .padding(vertical = NuvioTokens.Space.s6),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(tokens.spacing.controlGap),
+                ) {
+                    RadioButton(
+                        selected = selectedAddonId == id,
+                        onClick = { onAddonSelected(id) },
+                    )
+                    Text(
+                        text = name,
+                        style = MaterialTheme.typography.bodyLarge,
+                        color = tokens.colors.textPrimary,
+                    )
+                }
+            }
+
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.End,
+            ) {
+                TextButton(onClick = onDismiss) {
+                    Text(text = stringResource(Res.string.action_cancel), maxLines = 1)
+                }
+            }
+        }
+    }
+}
