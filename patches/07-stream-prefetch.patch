+@Composable
+@OptIn(ExperimentalMaterial3Api::class)
+private fun AutoDownloadSourceDialog(
+    currentSource: AutoDownloadSource,
+    onSourceSelected: (AutoDownloadSource) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val tokens = MaterialTheme.nuvio
+    BasicAlertDialog(onDismissRequest = onDismiss) {
+        PlusDialogSurface(title = "Sorgente download automatico") {
+            Text(
+                text = "Seleziona da quale sorgente avviare il download automatico. Se selezioni entrambi, scarica da chi risponde per primo:",
+                style = MaterialTheme.typography.bodyMedium,
+                color = tokens.colors.textSecondary,
+            )
+
+            val options = listOf(
+                AutoDownloadSource.BOTH to "Entrambi (Chi arriva prima)",
+                AutoDownloadSource.ADDONS to "Solo Addon (Torrent Cached / HTTP)",
+                AutoDownloadSource.REPOSITORIES to "Solo Repository Plugin",
+            )
+
+            options.forEach { (source, label) ->
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable { onSourceSelected(source) }
+                        .padding(vertical = NuvioTokens.Space.s6),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(tokens.spacing.controlGap),
+                ) {
+                    RadioButton(
+                        selected = source == currentSource,
+                        onClick = { onSourceSelected(source) },
+                    )
+                    Text(
+                        text = label,
+                        style = MaterialTheme.typography.bodyLarge,
+                        color = tokens.colors.textPrimary,
+                    )
+                }
+            }
+
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.End,
+            ) {
+                TextButton(onClick = onDismiss) {
+                    Text(text = stringResource(Res.string.action_cancel), maxLines = 1)
+                }
+            }
+        }
+    }
+}
+
+@Composable
+@OptIn(ExperimentalMaterial3Api::class)
+private fun AddonFilterDialog(
+    selectedAddonId: String?,
