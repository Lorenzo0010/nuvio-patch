+package com.nuvio.app.features.downloads
+
+import android.content.Context
+import android.content.SharedPreferences
+import com.nuvio.app.core.storage.ProfileScopedKey
+
+internal actual object DownloadsStorage {
+    private const val preferencesName = "nuvio_downloads"
+    private const val payloadKey = "downloads_payload"
+    private const val downloadLocationUriKey = "download_location_uri"
+    private const val autoDownloadSourceKey = "auto_download_source"
+    private const val preferredAddonIdKey = "auto_download_addon_id"
+    private const val preferredRepositoryIdKey = "auto_download_repository_id"
+
+    private var preferences: SharedPreferences? = null
+
+    fun initialize(context: Context) {
+        preferences = context.getSharedPreferences(preferencesName, Context.MODE_PRIVATE)
+    }
+
+    actual fun loadPayload(): String? =
+        preferences?.getString(ProfileScopedKey.of(payloadKey), null)
+
+    actual fun savePayload(payload: String) {
+        preferences
+            ?.edit()
+            ?.putString(ProfileScopedKey.of(payloadKey), payload)
+            ?.apply()
+    }
+
+    actual fun loadPayload(key: String): String? =
+        preferences?.getString(ProfileScopedKey.of("ext__$key"), null)
+
+    actual fun savePayload(payload: String, key: String) {
+        preferences
+            ?.edit()
+            ?.putString(ProfileScopedKey.of("ext__$key"), payload)
+            ?.apply()
+    }
+
+    actual fun getDownloadLocationUri(): String? =
+        preferences?.getString(ProfileScopedKey.of(downloadLocationUriKey), null)
+
+    actual fun setDownloadLocationUri(uri: String?) {
+        preferences
+            ?.edit()
+            ?.run {
+                if (uri == null) {
+                    remove(ProfileScopedKey.of(downloadLocationUriKey))
+                } else {
+                    putString(ProfileScopedKey.of(downloadLocationUriKey), uri)
+                }
+            }
+            ?.apply()
+    }
+
+    actual fun getAutoDownloadSource(): String? =
+        preferences?.getString(ProfileScopedKey.of(autoDownloadSourceKey), null)
+
+    actual fun setAutoDownloadSource(source: String?) {
+        preferences
+            ?.edit()
+            ?.run {
+                if (source == null) {
+                    remove(ProfileScopedKey.of(autoDownloadSourceKey))
+                } else {
+                    putString(ProfileScopedKey.of(autoDownloadSourceKey), source)
+                }
+            }
+            ?.apply()
+    }
+
+    actual fun getPreferredAddonId(): String? =
+        preferences?.getString(ProfileScopedKey.of(preferredAddonIdKey), null)
+
+    actual fun setPreferredAddonId(addonId: String?) {
+        preferences
+            ?.edit()
+            ?.run {
+                if (addonId == null) {
+                    remove(ProfileScopedKey.of(preferredAddonIdKey))
+                } else {
+                    putString(ProfileScopedKey.of(preferredAddonIdKey), addonId)
+                }
+            }
+            ?.apply()
+    }
+
+    actual fun getPreferredRepositoryId(): String? =
+        preferences?.getString(ProfileScopedKey.of(preferredRepositoryIdKey), null)
+
+    actual fun setPreferredRepositoryId(repositoryId: String?) {
+        preferences
+            ?.edit()
+            ?.run {
+                if (repositoryId == null) {
+                    remove(ProfileScopedKey.of(preferredRepositoryIdKey))
+                } else {
+                    putString(ProfileScopedKey.of(preferredRepositoryIdKey), repositoryId)
+                }
+            }
+            ?.apply()
+    }
+}
