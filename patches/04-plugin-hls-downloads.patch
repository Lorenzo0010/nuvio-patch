+@OptIn(ExperimentalForeignApi::class)
+private suspend fun downloadSingleHlsTrackIos(
+    downloadsDirectory: String,
+    url: String,
+    headers: Map<String, String>,
+    handle: IosDownloadsTaskHandle,
+    tempName: String,
+    finalName: String,
