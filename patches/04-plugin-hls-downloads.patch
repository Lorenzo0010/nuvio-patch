+    data class Success(val item: DownloadItem) : StartAttemptResult
+    data class Failed(val reason: String) : StartAttemptResult
+}
+
+object AutoStreamDownloader {
+    private val log = Logger.withTag("AutoDownloader")
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val _activeSearches = MutableStateFlow<Set<String>>(emptySet())
+    val activeSearches: StateFlow<Set<String>> = _activeSearches.asStateFlow()
+
+    /** Ordered queue of pending auto-download requests waiting to be processed. */
+    private val _pendingQueue = MutableStateFlow<List<PendingAutoDownloadRequest>>(emptyList())
+    val pendingQueue: StateFlow<List<PendingAutoDownloadRequest>> = _pendingQueue.asStateFlow()
+
+    /** Whether the queue-worker coroutine is currently running. */
+    private var queueWorkerJob: Job? = null
+
+    private val json = kotlinx.serialization.json.Json { ignoreUnknownKeys = true; encodeDefaults = true }
+    private const val PENDING_QUEUE_KEY = "auto_download_pending_queue"
+
+    private fun savePendingQueue() {
+        try {
+            val payload = json.encodeToString(_pendingQueue.value)
+            DownloadsStorage.savePayload(payload, PENDING_QUEUE_KEY)
+        } catch (e: Throwable) {
+            InAppLogger.error("AutoDownloader", "Errore salvataggio coda: ${e.message}")
+        }
+    }
+
+    private fun loadPendingQueue() {
+        try {
+            val payload = DownloadsStorage.loadPayload(PENDING_QUEUE_KEY).orEmpty()
+            if (payload.isNotBlank()) {
+                val list = json.decodeFromString<List<PendingAutoDownloadRequest>>(payload)
+                _pendingQueue.value = list
+                // Ricrea placeholder per ogni item in coda
+                list.forEach { req ->
+                    DownloadsRepository.registerPlaceholder(
+                        contentType = req.contentType,
+                        videoId = req.targetVideoId,
+                        parentMetaId = req.meta.id,
+                        parentMetaType = req.meta.type,
+                        title = req.meta.name,
+                        logo = req.meta.logo,
+                        poster = req.meta.poster,
+                        background = req.meta.background,
+                        seasonNumber = req.seasonNumber,
+                        episodeNumber = req.episodeNumber,
+                        episodeTitle = req.episodeTitle,
+                        episodeThumbnail = req.episodeThumbnail,
+                        phaseMessage = "In coda: ${req.displayTitle}",
+                    )
+                }
+                log.d { "Coda ripristinata: ${list.size} elementi" }
+            }
+        } catch (e: Throwable) {
+            InAppLogger.error("AutoDownloader", "Errore caricamento coda: ${e.message}")
+            _pendingQueue.value = emptyList()
+        }
+    }
+
+    init {
+        loadPendingQueue()
+    }
+
+    fun isSearching(key: String): Boolean = key in _activeSearches.value
+
+    /** Returns true if this content key is in the pending queue (not yet being processed). */
+    fun isQueuedForDownload(contentKey: String): Boolean =
+        _pendingQueue.value.any { it.contentKey == contentKey }
+
+    /** Removes an item from the pending queue (user-initiated cancel before it starts). */
+    fun cancelAutoDownload(contentKey: String) {
+        _pendingQueue.update { queue -> queue.filterNot { it.contentKey == contentKey } }
+        savePendingQueue()
+        DownloadsRepository.removePlaceholderByKey(contentKey)
+    }
+
+    private fun isPluginGroup(group: AddonStreamGroup): Boolean =
+        group.addonId.startsWith("plugin:") || group.addonId.startsWith("plugin-repo:")
+
+    private fun isAddonGroup(group: AddonStreamGroup): Boolean =
+        !isPluginGroup(group)
+
+    private fun isPluginStream(stream: StreamItem): Boolean =
+        stream.addonId.startsWith("plugin:") ||
+        stream.addonId.startsWith("plugin-repo:") ||
+        stream.sourceName != null
+
+    private fun isAddonStream(stream: StreamItem): Boolean =
+        !isPluginStream(stream)
+
+    private fun matchesRepository(stream: StreamItem, preferredRepo: String?): Boolean {
+        if (preferredRepo.isNullOrBlank()) return true
+        val target = preferredRepo.trim().lowercase()
+        val addonId = stream.addonId.lowercase()
+        val addonName = stream.addonName?.lowercase().orEmpty()
+        val sourceName = stream.sourceName?.lowercase().orEmpty()
+        return addonId == target ||
+            addonId == "plugin-repo:$target" ||
+            addonId.contains(target) ||
+            addonName == target ||
+            sourceName == target
+    }
+
+    private fun matchesAddon(addonName: String?, addonId: String?, preferredAddon: String?): Boolean {
+        if (preferredAddon.isNullOrBlank()) return true
+        val target = preferredAddon.trim().lowercase()
+        val aName = addonName?.lowercase()?.trim().orEmpty()
+        val aId = addonId?.lowercase()?.trim().orEmpty()
+
+        // 1. Corrispondenza diretta o per contenimento su addonName o addonId
+        if (aName == target || aName.contains(target) || target.contains(aName)) return true
+        if (aId == target || aId.contains(target) || target.contains(aId)) return true
+
+        // 2. Controllo per Stremio instance id "addon:<manifestId>:<manifestUrl>"
+        if (aId.startsWith("addon:")) {
+            val parts = aId.removePrefix("addon:").split(":", limit = 2)
+            val manifestId = parts.getOrNull(0)?.lowercase().orEmpty()
+            val manifestUrl = parts.getOrNull(1)?.lowercase().orEmpty()
+            if (manifestId.isNotBlank() && (manifestId == target || target.contains(manifestId) || manifestId.contains(target))) return true
+            if (manifestUrl.isNotBlank() && (manifestUrl == target || manifestUrl.contains(target) || target.contains(manifestUrl))) return true
+        }
+
+        // 3. Risoluzione tramite AddonRepository per sicurezza totale
+        val matchingAddon = try {
+            AddonRepository.uiState.value.addons.firstOrNull { addon ->
+                val mId = addon.manifest?.id?.lowercase().orEmpty()
+                val mUrl = addon.manifestUrl.lowercase()
+                val dTitle = addon.displayTitle.lowercase()
+                val mName = addon.manifest?.name?.lowercase().orEmpty()
+                target == mId || target == mUrl || target == dTitle || target == mName ||
+                    (mId.isNotBlank() && target.contains(mId)) ||
+                    (mUrl.isNotBlank() && target.contains(mUrl))
+            }
+        } catch (_: Throwable) {
+            null
+        }
+
+        if (matchingAddon != null) {
+            val mId = matchingAddon.manifest?.id?.lowercase().orEmpty()
+            val mUrl = matchingAddon.manifestUrl.lowercase()
+            val dTitle = matchingAddon.displayTitle.lowercase()
+            val mName = matchingAddon.manifest?.name?.lowercase().orEmpty()
+
+            if (aName == dTitle || aName == mName || aName.contains(dTitle) || dTitle.contains(aName)) return true
+            if (mUrl.isNotBlank() && aId.contains(mUrl)) return true
+            if (mId.isNotBlank() && (aId.contains(":$mId:") || aId.contains("addon:$mId") || aId == mId)) return true
+        }
+
+        return false
+    }
+
+    private fun matchesAddon(stream: StreamItem, preferredAddon: String?): Boolean {
+        return matchesAddon(stream.addonName, stream.addonId, preferredAddon)
+    }
+
+    private fun matchesAddonGroup(group: AddonStreamGroup, preferredAddon: String?): Boolean {
+        if (preferredAddon.isNullOrBlank()) return true
+        if (matchesAddon(group.addonName, group.addonId, preferredAddon)) return true
+        if (group.streams.any { matchesAddon(it, preferredAddon) }) return true
+        return false
+    }
+
+    /**
+     * Identifica se uno stream è un torrent in cache (Debrid Cached) o stream diretto Debrid.
+     * Include:
+     * - Torrent verificati in cache con status CACHED
+     * - Flussi debrid diretti (clientResolve.isDirectDebridCandidate)
+     * - Flussi pre-risolti da addon (es. AIOStreams / Torrentio con RD+ o lightning bolt ⚡)
+     */
+    private fun isCachedTorrentStream(stream: StreamItem): Boolean {
+        if (stream.debridCacheStatus?.state == StreamDebridCacheState.CACHED) return true
+        if (stream.isCachedDebridTorrentStream) return true
+        if (stream.isDirectDebridStream) return true
+
+        val textToSearch = listOfNotNull(
+            stream.name,
+            stream.title,
+            stream.description,
+            stream.addonName,
+        ).joinToString(" ")
+
+        if (textToSearch.contains("RD+", ignoreCase = true) ||
+            textToSearch.contains("[RD+]", ignoreCase = true) ||
+            textToSearch.contains("(RD+)", ignoreCase = true) ||
+            textToSearch.contains("AD+", ignoreCase = true) ||
+            textToSearch.contains("[AD+]", ignoreCase = true) ||
+            textToSearch.contains("PM+", ignoreCase = true) ||
+            textToSearch.contains("[PM+]", ignoreCase = true) ||
+            textToSearch.contains("TB+", ignoreCase = true) ||
+            textToSearch.contains("[TB+]", ignoreCase = true) ||
+            textToSearch.contains("⚡") ||
+            textToSearch.contains("RealDebrid Instant", ignoreCase = true) ||
+            textToSearch.contains("Debrid: cached", ignoreCase = true)
+        ) {
+            return true
+        }
+
+        val url = stream.playableDirectUrl.orEmpty().ifBlank { stream.url.orEmpty() }
+        if (url.contains("real-debrid.com", ignoreCase = true) ||
+            url.contains("alldebrid.com", ignoreCase = true) ||
+            url.contains("premiumize.me", ignoreCase = true) ||
+            url.contains("torbox.app", ignoreCase = true) ||
+            url.contains("debrid-link.fr", ignoreCase = true)
+        ) {
+            return true
+        }
+
+        return false
+    }
+
+    /**
+     * Verifica se uno stream torrent è attualmente in fase di verifica cache Debrid.
+     */
+    private fun isCheckingTorrentStream(stream: StreamItem): Boolean {
+        if (stream.debridCacheStatus?.state == StreamDebridCacheState.CHECKING) return true
+        if (stream.isTorrentStream && stream.debridCacheStatus?.state == null && stream.needsLocalDebridResolve) {
+            return true
+        }
+        return false
+    }
+
+    /**
+     * Identifica se uno stream da addon è un flusso HTTP diretto (hoster / DDL da addon come AIOStreams).
+     */
+    private fun isAddonHttpStream(stream: StreamItem): Boolean {
+        if (!isAddonStream(stream)) return false
+        if (isCachedTorrentStream(stream)) return false
+        val url = stream.playableDirectUrl.orEmpty().ifBlank { stream.url.orEmpty() }
+        return url.startsWith("http://", ignoreCase = true) || url.startsWith("https://", ignoreCase = true)
+    }
+
+    /**
+     * Ordine di priorità per il download automatico:
+     * Tier 0: Torrent Cached (RealDebrid / Debrid-cached torrents dagli addon)
+     * Tier 1: Addon HTTP (flussi HTTP / DDL dagli addon come AIOStreams)
+     * Tier 2: Plugin Stream (CloudStream scrapers)
+     * Tier 3: Altro (es. torrent non in cache, P2P)
+     */
+    private fun streamPriorityRank(stream: StreamItem): Int {
+        return when {
+            isCachedTorrentStream(stream) && isAddonStream(stream) -> 0
+            isAddonHttpStream(stream) -> 1
+            isPluginStream(stream) -> 2
+            else -> 3
+        }
+    }
+
+    private fun streamPriorityLabel(stream: StreamItem): String {
+        return when (streamPriorityRank(stream)) {
+            0 -> "Torrent Cached"
+            1 -> "Addon HTTP"
+            2 -> "Plugin"
+            else -> "Altro"
+        }
+    }
+
+    private suspend fun resolveEffectiveStream(
+        candidate: StreamItem,
+        seasonNumber: Int?,
+        episodeNumber: Int?,
+    ): StreamItem? {
+        if (DirectDebridPlaybackResolver.shouldResolveToPlayableStream(candidate)) {
+            val resolved = DirectDebridPlaybackResolver.resolveToPlayableStream(
+                stream = candidate,
+                season = seasonNumber,
+                episode = episodeNumber,
+            )
+            return when (resolved) {
+                is DirectDebridPlayableResult.Success -> {
+                    val resolvedUrl = resolved.stream.playableDirectUrl.orEmpty().ifBlank { resolved.stream.url.orEmpty() }
+                    if (resolvedUrl.isNotBlank()) resolved.stream else null
+                }
+                else -> null
+            }
+        }
+        val directUrl = candidate.playableDirectUrl ?: candidate.url?.takeIf {
+            it.startsWith("http://", ignoreCase = true) || it.startsWith("https://", ignoreCase = true)
+        }
+        if (!directUrl.isNullOrBlank()) {
+            return candidate
+        }
+        return null
+    }
+
+    private suspend fun attemptStartDownloadCandidate(
+        placeholderId: String?,
+        stream: StreamItem,
+        meta: MetaDetails,
+        contentType: String,
+        targetVideoId: String,
+        seasonNumber: Int?,
+        episodeNumber: Int?,
+        episodeTitle: String?,
+        episodeThumbnail: String?,
+        displayTitle: String,
+    ): StartAttemptResult {
+        if (placeholderId == null) {
+            return StartAttemptResult.Failed("Download annullato")
+        }
+        val resolvedUrl = stream.playableDirectUrl.orEmpty().ifBlank { stream.url.orEmpty() }
+        val isHlsStream = resolvedUrl.isNotBlank() && (
+            HlsPlaylistParser.isHlsUrl(resolvedUrl) ||
+            HlsPlaylistParser.isHlsStream(stream.streamType) ||
+            DownloadsRepository.probeIsHls(stream)
+        )
+
+        val adopted: DownloadItem? = if (isHlsStream) {
+            val metadata = DownloadsRepository.fetchHlsMasterPlaylist(stream)
+            val master = metadata?.masterPlaylist
+            if (master != null && master.variants.isNotEmpty()) {
+                val bestVariant = master.variants.sortedWith(
+                    compareByDescending<HlsVariant> { parseResolutionPixels(it.resolution) }
+                        .thenByDescending { it.bandwidth }
+                ).first()
+
+                val audioTracks = master.audioTracks.filter { it.uri != null }
+                val italianAudio = audioTracks.firstOrNull { isItalianTrack(it) } ?: audioTracks.firstOrNull()
+                val selectedAudioUrls = listOfNotNull(italianAudio?.uri)
+
+                val displayQuality = bestVariant.resolution ?: "${(bestVariant.bandwidth / 1000)}kbps"
+                val displayAudio = italianAudio?.name.orEmpty()
+
+                val selection = HlsDownloadSelection(
+                    variantUrl = bestVariant.url,
+                    audioUrls = selectedAudioUrls,
+                    subtitleUrls = emptyList(),
+                    displayQuality = displayQuality,
+                    displayAudio = displayAudio,
+                    displaySubtitle = "",
+                )
+
+                DownloadsRepository.adoptHlsSelection(
+                    placeholderId = placeholderId,
+                    stream = stream,
+                    selection = selection,
+                )
+            } else {
+                DownloadsRepository.adoptDirectStream(
+                    placeholderId = placeholderId,
+                    stream = stream,
+                    sourceUrl = resolvedUrl,
+                )
+            }
+        } else {
+            DownloadsRepository.adoptDirectStream(
+                placeholderId = placeholderId,
+                stream = stream,
+                sourceUrl = resolvedUrl,
+            )
+        }
+
+        if (adopted == null) {
+            return StartAttemptResult.Failed("Download annullato o rimosso")
+        }
+
+        val downloadId = adopted.id
+        log.d { "Monitoraggio avvio download ($downloadId) per: $displayTitle..." }
+
+        // Finestra di monitoraggio iniziale ("fallisce in partenza"): fino a 6 secondi.
+        // A fallimento la riga resta (stesso id) e si passa al candidato successivo.
+        val monitorStartMs = DownloadsClock.nowEpochMs()
+        val monitorTimeoutMs = 6_000L
+        while (DownloadsClock.nowEpochMs() - monitorStartMs < monitorTimeoutMs) {
+            delay(250L)
+            DownloadsRepository.ensureLoaded()
+            val currentItem = DownloadsRepository.uiState.value.items.firstOrNull { it.id == downloadId }
+            if (currentItem == null) {
+                return StartAttemptResult.Failed("Download annullato o rimosso")
+            }
+            if (currentItem.status == DownloadStatus.Failed) {
+                log.w { "Download fallito in partenza: ${currentItem.errorMessage}. Fallback..." }
+                val reason = currentItem.errorMessage ?: "Download fallito in partenza"
+                DownloadsRepository.resetPlaceholderForRetry(downloadId, "Stream non disponibile, provo il successivo...")
+                return StartAttemptResult.Failed(reason)
+            }
+            if (currentItem.status == DownloadStatus.Completed) {
+                return StartAttemptResult.Success(currentItem)
+            }
+            if (currentItem.downloadedBytes > 0L) {
+                // Byte ricevuti con successo! Breve conferma di stabilità (500ms)
+                delay(500L)
+                DownloadsRepository.ensureLoaded()
+                val verifyItem = DownloadsRepository.uiState.value.items.firstOrNull { it.id == downloadId }
+                if (verifyItem?.status == DownloadStatus.Failed) {
+                    val reason = verifyItem.errorMessage ?: "Download fallito in partenza"
+                    DownloadsRepository.resetPlaceholderForRetry(downloadId, "Stream non disponibile, provo il successivo...")
+                    return StartAttemptResult.Failed(reason)
+                }
+                val safeItem: DownloadItem = verifyItem ?: currentItem
+                return StartAttemptResult.Success(safeItem)
+            }
+        }
+
+        DownloadsRepository.ensureLoaded()
+        val finalItem = DownloadsRepository.uiState.value.items.firstOrNull { it.id == downloadId }
+        return if (finalItem != null) {
+            if (finalItem.status == DownloadStatus.Failed) {
+                val reason = finalItem.errorMessage ?: "Download fallito in partenza"
+                DownloadsRepository.resetPlaceholderForRetry(downloadId, "Stream non disponibile, provo il successivo...")
+                StartAttemptResult.Failed(reason)
+            } else {
+                StartAttemptResult.Success(finalItem)
+            }
+        } else {
+            StartAttemptResult.Failed("Download annullato o rimosso")
+        }
+    }
+
+    fun isItemDownloaded(
+        parentMetaId: String,
+        seasonNumber: Int? = null,
+        episodeNumber: Int? = null,
+        videoId: String? = null,
+    ): Boolean {
+        DownloadsRepository.ensureLoaded()
+        return DownloadsRepository.findPlayableDownload(
+            parentMetaId = parentMetaId,
+            seasonNumber = seasonNumber,
+            episodeNumber = episodeNumber,
+            videoId = videoId,
+        ) != null
+    }
+
+    fun isItemDownloading(
+        parentMetaId: String,
+        seasonNumber: Int? = null,
+        episodeNumber: Int? = null,
+    ): Boolean {
+        val logicalKey = buildLogicalKey(parentMetaId, seasonNumber, episodeNumber)
+        if (logicalKey in _activeSearches.value) return true
+        if (isQueuedForDownload(logicalKey)) return true
+        DownloadsRepository.ensureLoaded()
+        val items = DownloadsRepository.uiState.value.items
+        return items.any {
+            it.logicalContentKey == logicalKey && (
+                it.status == DownloadStatus.Downloading ||
+                it.status == DownloadStatus.Processing
+            )
+        }
+    }
+
+    fun startAutoDownload(
+        meta: MetaDetails,
+        episode: MetaVideo? = null,
+    ) {
+        val isSeries = (meta.type == "series" || meta.videos.isNotEmpty()) && episode != null
+        val contentType = if (isSeries) "series" else meta.type
+        val seasonNumber = if (isSeries) episode?.season else null
+        val episodeNumber = if (isSeries) episode?.episode else null
+        val episodeTitle = if (isSeries) episode?.title else null
+        val episodeThumbnail = if (isSeries) episode?.thumbnail else null
+        val targetVideoId = if (isSeries) {
+            episode?.id?.takeIf { it.isNotBlank() } ?: buildPlaybackVideoId(
+                parentMetaId = meta.id,
+                seasonNumber = seasonNumber,
+                episodeNumber = episodeNumber,
+                fallbackVideoId = episode?.id,
+            )
+        } else {
+            meta.id
+        }
+        val displayTitle = if (isSeries && episodeNumber != null) {
+            val season = seasonNumber ?: 1
+            "${meta.name} S${season}E${episodeNumber}"
+        } else {
+            meta.name
+        }
+        val contentKey = buildLogicalKey(meta.id, seasonNumber, episodeNumber)
+
+        // Guard: already actively searching or already in queue
+        if (contentKey in _activeSearches.value || isQueuedForDownload(contentKey)) {
+            NuvioToastController.show("Download già in coda...")
+            return
+        }
+
+        DownloadsRepository.ensureLoaded()
+        DownloadsSettingsRepository.ensureLoaded()
+        if (isItemDownloaded(meta.id, seasonNumber, episodeNumber, targetVideoId)) {
+            NuvioToastController.show("Contenuto già scaricato")
+            return
+        }
+        if (isItemDownloading(meta.id, seasonNumber, episodeNumber)) {
+            NuvioToastController.show("Download già in corso")
+            return
+        }
+
+        // Enqueue the request; stream fetching happens JIT when this item reaches the front.
+        val request = PendingAutoDownloadRequest(
+            contentKey = contentKey,
+            displayTitle = displayTitle,
+            meta = meta,
+            episode = episode,
+            contentType = contentType,
+            targetVideoId = targetVideoId,
+            seasonNumber = seasonNumber,
+            episodeNumber = episodeNumber,
+            episodeTitle = episodeTitle,
+            episodeThumbnail = episodeThumbnail,
+        )
+        _pendingQueue.update { it + request }
+
+        // Riga subito visibile in Download (anche durante prefetch): id stabile,
+        // aggiornata in place per ogni fase, mai ricreata.
+        DownloadsRepository.registerPlaceholder(
+            contentType = contentType,
+            videoId = targetVideoId,
+            parentMetaId = meta.id,
+            parentMetaType = meta.type,
+            title = meta.name,
+            logo = meta.logo,
+            poster = meta.poster,
+            background = meta.background,
+            seasonNumber = seasonNumber,
+            episodeNumber = episodeNumber,
+            episodeTitle = episodeTitle,
+            episodeThumbnail = episodeThumbnail,
+            phaseMessage = "In coda: $displayTitle",
+        )
+
+        val queueSize = _pendingQueue.value.size
+        if (queueSize > 1) {
+            NuvioToastController.show("Aggiunto alla coda (#$queueSize): $displayTitle")
+        } else {
+            NuvioToastController.show("Avvio ricerca stream per: $displayTitle...")
+        }
+
+        // Start the worker if it isn't already running
+        ensureQueueWorkerRunning()
+    }
+
+    /**
+     * Ensures that a single queue-worker coroutine is running.
+     * The worker picks items one at a time from the front of the queue and executes them sequentially.
+     */
+    private fun ensureQueueWorkerRunning() {
+        if (queueWorkerJob?.isActive == true) return
+        queueWorkerJob = scope.launch {
+            while (true) {
+                val next = _pendingQueue.value.firstOrNull() ?: break
+                _pendingQueue.update { it.drop(1) }
+                savePendingQueue()
+                try {
+                    executeAutoDownload(next)
+                } catch (e: Throwable) {
+                    // Non-cancellation errors must not kill the worker.
+                    if (e is kotlinx.coroutines.CancellationException) throw e
+                    InAppLogger.error(
+                        "AutoDownloader",
+                        "Errore non gestito per ${next.displayTitle}, passo al prossimo: ${e.message}",
+                    )
+                    DownloadsRepository.removePlaceholderByKey(next.contentKey)
+                }
+            }
+            queueWorkerJob = null
+        }
+    }
+
+    /**
+     * Executes the stream-search + download for a single pending request.
+     * This is called JIT when the item reaches the front of the queue.
+     */
+    private suspend fun executeAutoDownload(request: PendingAutoDownloadRequest) {
+        val meta = request.meta
+        val contentType = request.contentType
+        val targetVideoId = request.targetVideoId
+        val seasonNumber = request.seasonNumber
+        val episodeNumber = request.episodeNumber
+        val episodeTitle = request.episodeTitle
+        val episodeThumbnail = request.episodeThumbnail
+        val displayTitle = request.displayTitle
+        val contentKey = request.contentKey
+
+        // Re-check: user may have cancelled or it may already exist
+        if (isItemDownloaded(meta.id, seasonNumber, episodeNumber, targetVideoId)) {
+            log.d { "Item già scaricato quando estratto dalla coda: $displayTitle" }
+            DownloadsRepository.removePlaceholderByKey(contentKey)
+            return
+        }
+
+        val notifId = "auto_$contentKey"
+
+        // ── placeholderId: re-read at each use to avoid stale capture after adopt/reset ──
+        fun currentPlaceholderId(): String? = DownloadsRepository.placeholderIdForKey(contentKey)
+
+        fun updatePhase(message: String) {
+            currentPlaceholderId()?.let { pid ->
+                DownloadsRepository.updatePlaceholderPhase(pid, message)
+            }
+            DownloadsLiveStatusPlatform.notifyProgress(
+                id = notifId,
+                title = displayTitle,
+                message = message,
+            )
+        }
+
+        // _activeSearches removal is guaranteed by try-finally even on early return
+        try {
+            val initialPlaceholderId = currentPlaceholderId()
+            if (initialPlaceholderId == null) {
+                // Placeholder removed by user before we could start: silent abort.
+                log.d { "Placeholder rimosso per $displayTitle, annullo." }
+                return
+            }
+            _activeSearches.update { it + contentKey }
+            NuvioToastController.show("Avvio ricerca stream per: $displayTitle...")
+
+            DownloadsLiveStatusPlatform.acquireKeepAlive(notifId, displayTitle)
+            updatePhase("Ricerca dello stream in corso...")
+
+            PlayerStreamsRepository.loadEpisodeStreams(
+                    type = contentType,
+                    videoId = targetVideoId,
+                    season = seasonNumber,
+                    episode = episodeNumber,
+                    forceRefresh = true,
+                )
+
+                val startEpochMs = DownloadsClock.nowEpochMs()
+                val addonWaitTimeoutMs = 30_000L
+                val totalTimeoutMs = 45_000L
+
+                val sourceMode = DownloadsSettingsRepository.autoDownloadSource.value
+                val preferredAddon = DownloadsSettingsRepository.preferredAddonId.value
+                val preferredRepo = DownloadsSettingsRepository.preferredRepositoryId.value
+
+                val hasStreamAddons = try {
+                    AddonRepository.uiState.value.addons.any {
+                        it.enabled && it.manifest?.resources?.any { r -> r.name == "stream" } == true
+                    }
+                } catch (_: Throwable) {
+                    true
+                }
+
+                var downloadStarted = false
+                var attemptedCount = 0
+                var startedDownloadId: String? = null
+
+                when (sourceMode) {
+                    AutoDownloadSource.REPOSITORIES -> {
+                        // Modalità: Solo Repository / Plugin (immediato, non attende gli addon)
+                        updatePhase("Ricerca stream nelle repository plugin...")
+
+                        while (DownloadsClock.nowEpochMs() - startEpochMs < totalTimeoutMs) {
+                            val state = PlayerStreamsRepository.episodeStreamsState.value
+                            val pluginGroups = state.groups.filter { isPluginGroup(it) }
+                            val pluginStreams = pluginGroups.flatMap { it.streams }
+                                .filter { isPluginStream(it) && matchesRepository(it, preferredRepo) }
+
+                            if (pluginStreams.isNotEmpty()) break
+                            if (!pluginGroups.any { it.isLoading }) break
+                            delay(250L)
+                        }
+
+                        val stateAfterPlugins = PlayerStreamsRepository.episodeStreamsState.value
+                        val pluginGroups = stateAfterPlugins.groups.filter { isPluginGroup(it) }
+                        val rawPluginStreams = pluginGroups.flatMap { it.streams }
+                            .filter { isPluginStream(it) && matchesRepository(it, preferredRepo) }
+
+                        if (rawPluginStreams.isNotEmpty()) {
+                            log.d { "Trovati ${rawPluginStreams.size} stream da plugin. Tentativo sequenziale..." }
+
+                            for (rawStream in rawPluginStreams) {
+                                val effectiveStream = resolveEffectiveStream(rawStream, seasonNumber, episodeNumber)
+                                if (effectiveStream == null) continue
+
+                                attemptedCount++
+                                val streamName = effectiveStream.addonName ?: "plugin"
+                                updatePhase("Tentativo avvio con: $streamName...")
+                                log.d { "Tentativo download con plugin stream #$attemptedCount (Plugin): $streamName - ${effectiveStream.streamLabel}" }
+
+                                val attemptResult = attemptStartDownloadCandidate(
+                                    placeholderId = currentPlaceholderId(),
+                                    stream = effectiveStream,
+                                    meta = meta,
+                                    contentType = contentType,
+                                    targetVideoId = targetVideoId,
+                                    seasonNumber = seasonNumber,
+                                    episodeNumber = episodeNumber,
+                                    episodeTitle = episodeTitle,
+                                    episodeThumbnail = episodeThumbnail,
+                                    displayTitle = displayTitle,
+                                )
+
+                                when (attemptResult) {
+                                    is StartAttemptResult.Success -> {
+                                        log.d { "Download plugin avviato con successo: $streamName" }
+                                        NuvioToastController.show("Download avviato: $displayTitle (Plugin)")
+                                        DownloadsLiveStatusPlatform.cancelNotification(notifId)
+                                        startedDownloadId = attemptResult.item.id
+                                        downloadStarted = true
+                                        break
+                                    }
+                                    is StartAttemptResult.Failed -> {
+                                        log.w { "Plugin stream $streamName fallito in partenza: ${attemptResult.reason}. Fallback al successivo..." }
+                                        NuvioToastController.show("Stream non disponibile, provo il successivo...")
+                                    }
+                                }
+                            }
+                        }
+                    }
+
+                    AutoDownloadSource.BOTH -> {
+                        // Modalità: Entrambi (Chi arriva prima - DEFAULT)
+                        // Se è specificato un addon preferito, diamo precedenza all'attesa dell'addon preferito.
+                        val hasSpecificAddonTarget = !preferredAddon.isNullOrBlank()
+
+                        DownloadsLiveStatusPlatform.notifyProgress(
+                            id = notifId,
+                            title = displayTitle,
+                            message = if (hasSpecificAddonTarget) {
+                                "Ricerca stream prioritari dall'addon selezionato..."
+                            } else {
+                                "Ricerca stream in corso (Addon e Repository)..."
+                            },
+                        )
+
+                        while (DownloadsClock.nowEpochMs() - startEpochMs < totalTimeoutMs) {
+                            val state = PlayerStreamsRepository.episodeStreamsState.value
+                            val pluginGroups = state.groups.filter { isPluginGroup(it) }
+                            val addonGroups = state.groups.filter { isAddonGroup(it) }
+
+                            val availablePluginStreams = pluginGroups.flatMap { it.streams }
+                                .filter { isPluginStream(it) && matchesRepository(it, preferredRepo) }
+
+                            val availableAddonStreams = addonGroups.flatMap { it.streams }
+                                .filter { isAddonStream(it) && matchesAddon(it, preferredAddon) }
+
+                            val isCheckingCache = availableAddonStreams.any { isCheckingTorrentStream(it) }
+                            val hasCachedTorrent = availableAddonStreams.any { isCachedTorrentStream(it) }
+
+                            if (hasSpecificAddonTarget) {
+                                // L'utente vuole uno specifico addon: attendiamo che termini il caricamento o i controlli cache
+                                val matchingAddonGroups = addonGroups.filter { matchesAddonGroup(it, preferredAddon) }
+                                val specificAddonFinished = matchingAddonGroups.isNotEmpty() && !matchingAddonGroups.any { it.isLoading } && !isCheckingCache
+                                if (hasCachedTorrent || (availableAddonStreams.isNotEmpty() && specificAddonFinished)) {
+                                    break
+                                }
+                                // Se l'addon preferito ha terminato senza risultati e i plugin sono pronti, procedi con fallback
+                                if (specificAddonFinished && availableAddonStreams.isEmpty() && availablePluginStreams.isNotEmpty()) {
+                                    break
+                                }
+                            } else {
+                                // Se sono arrivati i torrent cached o se i plugin sono già pronti (e non ci sono cache check in corso)
+                                if (hasCachedTorrent) {
+                                    break
+                                }
+                                if (availablePluginStreams.isNotEmpty() && !isCheckingCache) {
+                                    break
+                                }
+                            }
+
+                            val anythingStillLoading = state.isAnyLoading
+                            if (!anythingStillLoading && (availableAddonStreams.isNotEmpty() || availablePluginStreams.isNotEmpty())) {
+                                break
+                            }
+                            if (!anythingStillLoading && availableAddonStreams.isEmpty() && availablePluginStreams.isEmpty()) {
+                                break
+                            }
+
+                            delay(250L)
+                        }
+
+                        val finalState = PlayerStreamsRepository.episodeStreamsState.value
+                        val candidateStreams = buildList {
+                            val addonStreams = finalState.groups.filter { isAddonGroup(it) }.flatMap { it.streams }
+                                .filter { isAddonStream(it) && matchesAddon(it, preferredAddon) }
+                            val pluginStreams = finalState.groups.filter { isPluginGroup(it) }.flatMap { it.streams }
+                                .filter { isPluginStream(it) && matchesRepository(it, preferredRepo) }
+
+                            val sortedAddons = addonStreams.sortedBy { streamPriorityRank(it) }
+                            val cachedTorrents = sortedAddons.filter { streamPriorityRank(it) == 0 }
+                            val httpAddons = sortedAddons.filter { streamPriorityRank(it) == 1 }
+                            val otherAddons = sortedAddons.filter { streamPriorityRank(it) > 1 }
+
+                            if (hasSpecificAddonTarget) {
+                                // Addon preferito: torrent cached > http > other > fallback plugin
+                                addAll(cachedTorrents)
+                                addAll(httpAddons)
+                                addAll(otherAddons)
+                                addAll(pluginStreams)
+                            } else {
+                                // Chi arriva prima standard: torrent cached > plugin (se pronti) > addon http > altri
+                                addAll(cachedTorrents)
+                                addAll(pluginStreams)
+                                addAll(httpAddons)
+                                addAll(otherAddons)
+                            }
+                        }
+
+                        if (candidateStreams.isNotEmpty()) {
+                            log.d { "Trovati ${candidateStreams.size} stream candidati (Chi arriva prima). Tentativo..." }
+
+                            for (rawStream in candidateStreams) {
+                                val effectiveStream = resolveEffectiveStream(rawStream, seasonNumber, episodeNumber)
+                                if (effectiveStream == null) continue
+
+                                val priorityLabel = streamPriorityLabel(effectiveStream)
+                                attemptedCount++
+                                val streamName = effectiveStream.addonName ?: "stream"
+                                updatePhase("Tentativo avvio con: $streamName ($priorityLabel)...")
+                                log.d { "Tentativo download con stream #$attemptedCount ($priorityLabel): $streamName - ${effectiveStream.streamLabel}" }
+
+                                val attemptResult = attemptStartDownloadCandidate(
+                                    placeholderId = currentPlaceholderId(),
+                                    stream = effectiveStream,
+                                    meta = meta,
+                                    contentType = contentType,
+                                    targetVideoId = targetVideoId,
+                                    seasonNumber = seasonNumber,
+                                    episodeNumber = episodeNumber,
+                                    episodeTitle = episodeTitle,
+                                    episodeThumbnail = episodeThumbnail,
+                                    displayTitle = displayTitle,
+                                )
+
+                                when (attemptResult) {
+                                    is StartAttemptResult.Success -> {
+                                        log.d { "Download avviato con successo ($priorityLabel): $streamName" }
+                                        NuvioToastController.show("Download avviato: $displayTitle ($priorityLabel)")
+                                        DownloadsLiveStatusPlatform.cancelNotification(notifId)
+                                        startedDownloadId = attemptResult.item.id
+                                        downloadStarted = true
+                                        break
+                                    }
+                                    is StartAttemptResult.Failed -> {
+                                        log.w { "Stream $streamName ($priorityLabel) fallito in partenza: ${attemptResult.reason}. Fallback al successivo..." }
+                                        NuvioToastController.show("Stream non disponibile, provo il successivo...")
+                                    }
+                                }
+                            }
+                        }
+                    }
+
+                    AutoDownloadSource.ADDONS -> {
+                        // Modalità: Solo Addon (privilegia Torrent Cached > Addon HTTP - MAI fallback su plugin)
+                        updatePhase("Ricerca stream dagli addon (Torrent Cached / HTTP)...")
+
+                        if (hasStreamAddons) {
+                            var cachedTorrentDetectedAtMs: Long? = null
+                            val hasSpecificAddonTarget = !preferredAddon.isNullOrBlank()
+
+                            while (DownloadsClock.nowEpochMs() - startEpochMs < addonWaitTimeoutMs) {
+                                val state = PlayerStreamsRepository.episodeStreamsState.value
+                                val addonGroups = state.groups.filter { isAddonGroup(it) }
+
+                                if (addonGroups.isEmpty() && state.isAnyLoading) {
+                                    delay(250L)
+                                    continue
+                                }
+
+                                val targetGroups = if (hasSpecificAddonTarget) {
+                                    addonGroups.filter { matchesAddonGroup(it, preferredAddon) }
+                                } else {
+                                    addonGroups
+                                }
+
+                                val currentAddonStreams = targetGroups.flatMap { it.streams }
+                                    .filter { isAddonStream(it) && matchesAddon(it, preferredAddon) }
+                                val isCheckingCache = currentAddonStreams.any { isCheckingTorrentStream(it) }
+                                val hasCachedTorrent = currentAddonStreams.any { isCachedTorrentStream(it) }
+
+                                if (isCheckingCache) {
+                                    updatePhase("Verifica disponibilità cache RealDebrid in corso...")
+                                }
+
+                                if (hasCachedTorrent) {
+                                    if (cachedTorrentDetectedAtMs == null) {
+                                        cachedTorrentDetectedAtMs = DownloadsClock.nowEpochMs()
+                                    }
+                                    val elapsedSinceDetect = DownloadsClock.nowEpochMs() - cachedTorrentDetectedAtMs
+                                    if (!isCheckingCache || elapsedSinceDetect >= 2_000L) {
+                                        val totalElapsed = DownloadsClock.nowEpochMs() - startEpochMs
+                                        DownloadsLiveStatusPlatform.notifyProgress(
+                                            id = notifId,
+                                            title = displayTitle,
+                                            message = "Trovato Torrent Cached. Avvio download...",
+                                        )
+                                        log.d { "Trovato torrent cached pronto in ${totalElapsed}ms. Avvio immediato senza attendere flussi HTTP." }
+                                        break
+                                    }
+                                } else {
+                                    val targetStillLoading = if (hasSpecificAddonTarget) {
+                                        targetGroups.isEmpty() || targetGroups.any { it.isLoading } || state.isAnyLoading
+                                    } else {
+                                        addonGroups.any { it.isLoading } || state.isAnyLoading
+                                    }
+
+                                    if (targetStillLoading) {
+                                        DownloadsLiveStatusPlatform.notifyProgress(
+                                            id = notifId,
+                                            title = displayTitle,
+                                            message = "Ricerca flussi dagli addon in corso...",
+                                        )
+                                    } else if (!isCheckingCache && targetGroups.isNotEmpty() && currentAddonStreams.isNotEmpty()) {
+                                        log.d { "Addon hanno terminato la risposta e i controlli cache (${targetGroups.size} gruppi, ${currentAddonStreams.size} stream)." }
+                                        break
+                                    } else if (!isCheckingCache && !state.isAnyLoading && targetGroups.isNotEmpty()) {
+                                        log.d { "Tutti gli addon hanno terminato senza ulteriori stream." }
+                                        break
+                                    }
+                                }
+
+                                delay(250L)
+                            }
+                        }
+
+                        val stateAfterAddons = PlayerStreamsRepository.episodeStreamsState.value
+                        val addonGroups = stateAfterAddons.groups.filter { isAddonGroup(it) }
+                        val rawAddonStreams = addonGroups.flatMap { it.streams }
+                            .filter { isAddonStream(it) && matchesAddon(it, preferredAddon) }
+
+                        if (rawAddonStreams.isNotEmpty()) {
+                            val sortedAddonStreams = rawAddonStreams.sortedBy { streamPriorityRank(it) }
+                            val cachedCount = sortedAddonStreams.count { streamPriorityRank(it) == 0 }
+                            val httpCount = sortedAddonStreams.count { streamPriorityRank(it) == 1 }
+                            log.d { "Trovati ${sortedAddonStreams.size} stream da addon ($cachedCount torrent cached, $httpCount addon http)." }
+
+                            for (rawStream in sortedAddonStreams) {
+                                val effectiveStream = resolveEffectiveStream(rawStream, seasonNumber, episodeNumber)
+                                if (effectiveStream == null) continue
+
+                                val priorityLabel = streamPriorityLabel(effectiveStream)
+                                attemptedCount++
+                                val streamName = effectiveStream.addonName ?: "addon"
+                                updatePhase("Tentativo avvio con: $streamName ($priorityLabel)...")
+                                log.d { "Tentativo download con addon stream #$attemptedCount ($priorityLabel): $streamName - ${effectiveStream.streamLabel}" }
+
+                                val attemptResult = attemptStartDownloadCandidate(
+                                    placeholderId = currentPlaceholderId(),
+                                    stream = effectiveStream,
+                                    meta = meta,
+                                    contentType = contentType,
+                                    targetVideoId = targetVideoId,
+                                    seasonNumber = seasonNumber,
+                                    episodeNumber = episodeNumber,
+                                    episodeTitle = episodeTitle,
+                                    episodeThumbnail = episodeThumbnail,
+                                    displayTitle = displayTitle,
+                                )
+
+                                when (attemptResult) {
+                                    is StartAttemptResult.Success -> {
+                                        log.d { "Download avviato con successo ($priorityLabel): $streamName" }
+                                        NuvioToastController.show("Download avviato: $displayTitle ($priorityLabel)")
+                                        DownloadsLiveStatusPlatform.cancelNotification(notifId)
+                                        startedDownloadId = attemptResult.item.id
+                                        downloadStarted = true
+                                        break
+                                    }
+                                    is StartAttemptResult.Failed -> {
+                                        log.w { "Stream $streamName ($priorityLabel) fallito in partenza: ${attemptResult.reason}. Fallback al successivo..." }
+                                        NuvioToastController.show("Stream non disponibile, provo il successivo...")
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+
+                // Wait for the started download to reach a terminal state before processing next queue item
+                val dlId = startedDownloadId
+                if (dlId != null) {
+                    log.d { "In attesa del completamento del download: $dlId" }
+                    try {
+                        while (true) {
+                            val item = DownloadsRepository.uiState.value.items.find { it.id == dlId }
+                            if (item == null) {
+                                log.d { "Item $dlId rimosso esternamente, esco dall'attesa." }
+                                break // removed externally
+                            }
+                            val status = item.status
+                            if (status == DownloadStatus.Completed ||
+                                status == DownloadStatus.Failed ||
+                                status == DownloadStatus.Paused
+                            ) {
+                                log.d { "Download $dlId raggiunto stato terminale: $status" }
+                                break
+                            }
+                            delay(1_000L)
+                        }
+                        log.d { "Download terminato (o rimosso), passo al prossimo in coda." }
+                    } catch (e: Throwable) {
+                        // Se il wait loop crasha, logghiamo e usciamo dalla funzione.
+                        // Il worker esterno passerà al prossimo item.
+                        InAppLogger.error("AutoDownloader", "Errore nel wait loop per $dlId: ${e.message}", e)
+                        throw e // Rilancia per far gestire al worker esterno
+                    }
+                }
+
+                // 3. Notifica esplicita se nessun download è riuscito a partire.
+                // Se la riga è stata cancellata dall'utente nel frattempo: nessun toast/notify.
+                if (!downloadStarted) {
+                    val finalPlaceholderId = currentPlaceholderId()
+                    val placeholderGone = finalPlaceholderId == null ||
+                        DownloadsRepository.uiState.value.items.none { it.id == finalPlaceholderId }
+                    if (placeholderGone) {
+                        log.d { "Placeholder rimosso per $displayTitle, nessun avviso." }
+                    } else {
+                        val failureMessage = if (attemptedCount > 0) {
+                            "Download fallito per $displayTitle: tutti gli stream disponibili sono falliti in partenza"
+                        } else {
+                            when (sourceMode) {
+                                AutoDownloadSource.ADDONS -> "Download fallito per $displayTitle: nessuno stream disponibile dagli addon"
+                                AutoDownloadSource.REPOSITORIES -> "Download fallito per $displayTitle: nessuno stream disponibile dalle repository"
+                                AutoDownloadSource.BOTH -> "Download fallito per $displayTitle: nessuno stream disponibile"
+                            }
+                        }
+                        log.e { failureMessage }
+                        NuvioToastController.show(failureMessage)
+                        DownloadsLiveStatusPlatform.notifyFailure(notifId, displayTitle, failureMessage)
+                        if (finalPlaceholderId != null) DownloadsRepository.cancelDownload(finalPlaceholderId)
+                    }
+                }
+            } catch (e: Throwable) {
+                InAppLogger.error("AutoDownloader", "Errore durante l'auto download per $displayTitle: ${e.message}")
+                val errorMsg = "Errore durante l'avvio del download: ${e.message ?: "sconosciuto"}"
+                NuvioToastController.show(errorMsg)
+                DownloadsLiveStatusPlatform.notifyFailure(notifId, displayTitle, errorMsg)
+            } finally {
+                _activeSearches.update { it - contentKey }
+                DownloadsLiveStatusPlatform.releaseKeepAlive(notifId)
+            }
+    }
+}
