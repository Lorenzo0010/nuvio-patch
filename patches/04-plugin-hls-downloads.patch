+private suspend fun performHlsDownloadAndroid(
+    context: Context,
+    request: DownloadPlatformRequest,
+    onProgress: (downloadedBytes: Long, totalBytes: Long?) -> Unit,
+    onSuccess: (localFileUri: String, totalBytes: Long?, companion: HlsCompanionOutcome?) -> Unit,
+    onFailure: (message: String) -> Unit,
+    onWarning: ((message: String) -> Unit)? = null,
+    onPhase: ((phase: String) -> Unit)? = null,
+    onTrackProgress: ((trackName: String, downloadedBytes: Long, totalBytes: Long?) -> Unit)? = null,
+) {
+    val downloadsDir = File(context.filesDir, "downloads").apply { mkdirs() }
+    val tempFile = File(downloadsDir, "${request.destinationFileName}.part")
+    if (tempFile.exists()) tempFile.delete()
+
+    val videoTempOut = FileOutputStream(tempFile, false)
+    val videoChannel = videoTempOut.channel
+
+    val ctx = coroutineContext
+    try {
+        val videoOutcome = downloadHlsToFile(
+            sourceUrl = request.sourceUrl,
+            httpGet = { url, range -> androidHttpGet(url, request.sourceHeaders, range) },
+            appendBytes = { bytes ->
+                videoTempOut.write(bytes)
+                videoChannel.force(false)
+            },
+            decryptAes128Cbc = ::aes128CbcDecryptAndroid,
+            onProgress = { downloaded, total ->
+                onProgress(downloaded, total)
+                onTrackProgress?.invoke("video", downloaded, total)
+            },
+            ensureActive = { ctx.ensureActive() },
+        )
+
+        videoTempOut.flush()
+        videoTempOut.close()
+
+        val finalVideoName = hlsOutputFileName(request.destinationFileName, videoOutcome.isFmp4)
+        val videoFinal = File(downloadsDir, finalVideoName)
+        if (videoFinal.exists()) videoFinal.delete()
+        if (!tempFile.renameTo(videoFinal)) {
+            tempFile.copyTo(videoFinal, overwrite = true)
+            tempFile.delete()
+        }
+
+        val videoUri = videoFinal.toURI().toString()
+        val audioUris = mutableListOf<String>()
+        val subtitleUris = mutableListOf<String>()
+
+        val audioUrls = if (request.hlsAudioUrls.isNotEmpty()) request.hlsAudioUrls
+        else listOfNotNull(request.hlsAudioUrl)
+
+        for ((index, audioUrl) in audioUrls.withIndex()) {
+            try {
+                val suffix = if (index == 0) "audio" else "audio_$index"
+                val audioFinalName = hlsCompanionFileName(finalVideoName, suffix, "mp4")
+                val audioTempName = hlsCompanionFileName(request.destinationFileName, suffix, "part")
+                val uri = downloadSingleHlsTrackAndroid(
+                    downloadsDir = downloadsDir,
+                    url = audioUrl,
+                    headers = request.sourceHeaders,
+                    finalName = audioFinalName,
+                    tempName = audioTempName,
+                    trackName = suffix,
+                    onTrackProgress = onTrackProgress,
+                    ctx = ctx,
+                )
+                audioUris.add(uri)
+            } catch (_: CancellationException) {
+                throw CancellationException()
+            } catch (_: Throwable) {
+            }
+        }
+
+        val subtitleUrls = if (request.hlsSubtitleUrls.isNotEmpty()) request.hlsSubtitleUrls
+        else listOfNotNull(request.hlsSubtitleUrl)
+
+        for ((index, subUrl) in subtitleUrls.withIndex()) {
+            try {
+                val suffix = if (index == 0) "subs" else "subs_$index"
+                val subFinalName = hlsCompanionFileName(finalVideoName, suffix, "vtt")
+                val subTempName = hlsCompanionFileName(request.destinationFileName, suffix, "part")
+                val uri = downloadSingleHlsTrackAndroid(
+                    downloadsDir = downloadsDir,
+                    url = subUrl,
+                    headers = request.sourceHeaders,
+                    finalName = subFinalName,
+                    tempName = subTempName,
+                    trackName = suffix,
+                    onTrackProgress = onTrackProgress,
+                    ctx = ctx,
+                )
+                subtitleUris.add(uri)
+            } catch (_: CancellationException) {
+                throw CancellationException()
+            } catch (_: Throwable) {
+            }
+        }
+
+        onSuccess(
+            videoUri,
+            videoOutcome.totalBytes,
+            HlsCompanionOutcome(
+                audioLocalFileUri = audioUris.firstOrNull(),
+                subtitleLocalFileUri = subtitleUris.firstOrNull(),
+                audioLocalFileUris = audioUris,
+                subtitleLocalFileUris = subtitleUris,
+            )
+        )
+    } catch (_: CancellationException) {
+        videoTempOut.closeSafe()
+        tempFile.delete()
+    } catch (error: Throwable) {
+        videoTempOut.closeSafe()
+        onFailure(error.message ?: runBlocking { getString(Res.string.downloads_status_failed) })
+    }
+}
+
+private suspend fun downloadSingleHlsTrackAndroid(
+    downloadsDir: File,
+    url: String,
+    headers: Map<String, String>,
+    finalName: String,
+    tempName: String,
+    trackName: String,
+    onTrackProgress: ((trackName: String, downloadedBytes: Long, totalBytes: Long?) -> Unit)?,
+    ctx: kotlin.coroutines.CoroutineContext,
+): String {
+    val tempTarget = File(downloadsDir, tempName)
+    if (tempTarget.exists()) tempTarget.delete()
+
+    val out = FileOutputStream(tempTarget, false)
+    val channel = out.channel
+
+    try {
+        val outcome = downloadHlsToFile(
+            sourceUrl = url,
+            httpGet = { u, range -> androidHttpGet(u, headers, range) },
+            appendBytes = { bytes ->
+                out.write(bytes)
+                channel.force(false)
+            },
+            decryptAes128Cbc = ::aes128CbcDecryptAndroid,
+            onProgress = { downloaded, total ->
+                onTrackProgress?.invoke(trackName, downloaded, total)
+            },
+            ensureActive = { ctx.ensureActive() },
+        )
+
+        out.flush()
+        out.close()
+
+        val actualFinalName = hlsOutputFileName(finalName, outcome.isFmp4)
+        val actualFinal = File(downloadsDir, actualFinalName)
+        if (actualFinal.exists()) actualFinal.delete()
+        if (!tempTarget.renameTo(actualFinal)) {
+            tempTarget.copyTo(actualFinal, overwrite = true)
+            tempTarget.delete()
+        }
+        return actualFinal.toURI().toString()
+    } catch (e: Throwable) {
+        out.closeSafe()
+        tempTarget.delete()
+        throw e
+    }
+}
+
+private suspend fun androidHttpGet(
+    url: String,
+    headers: Map<String, String>,
+    range: HlsByteRange?,
+): HlsHttpResult {
+    val requestBuilder = Request.Builder().url(url)
+    headers.forEach { (key, value) ->
+        requestBuilder.header(key, value)
+    }
+    if (range != null) {
+        requestBuilder.header(
+            "Range",
+            "bytes=${range.offset}-${range.offset + range.length - 1}",
+        )
+    }
+
+    val response = downloadHttpClient.newCall(requestBuilder.get().build()).execute()
+    return response.use { resp ->
+        HlsHttpResult(
+            status = resp.code,
+            body = resp.body?.bytes() ?: ByteArray(0),
+            finalUrl = resp.request.url.toString(),
+        )
+    }
+}
+
+private fun aes128CbcDecryptAndroid(data: ByteArray, key: ByteArray, iv: ByteArray): ByteArray {
+    if (data.isEmpty()) return ByteArray(0)
+    val cipher = Cipher.getInstance("AES/CBC/PKCS5Padding")
+    val keySpec = SecretKeySpec(key, "AES")
+    val ivSpec = IvParameterSpec(iv)
+    cipher.init(Cipher.DECRYPT_MODE, keySpec, ivSpec)
+    return cipher.doFinal(data)
+}
+
+private fun OutputStream.closeSafe() {
+    try { close() } catch (_: Exception) { }
+}
+
 private class AndroidDownloadsTaskHandle(
     private val job: Job,
 ) : DownloadsTaskHandle {
@@ -268,3 +514,14 @@ private fun parseContentRangeTotal(headerValue: String?): Long? {
     if (totalPart == "*") return null
     return totalPart.toLongOrNull()?.takeIf { it > 0L }
 }
+
+private fun hlsOutputFileName(baseName: String, isFmp4: Boolean): String {
+    val targetExt = if (isFmp4) "mp4" else "ts"
+    val stem = baseName.substringBeforeLast('.')
+    return "$stem.$targetExt"
+}
+
+private fun hlsCompanionFileName(mainFileName: String, trackType: String, ext: String): String {
+    val stem = mainFileName.substringBeforeLast('.')
+    return "${stem}_$trackType.$ext"
+}
