+package com.nuvio.app.features.downloads
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+enum class AutoDownloadSource(val storageKey: String) {
+    BOTH("both"),
+    ADDONS("addons"),
+    REPOSITORIES("repositories");
+
+    companion object {
+        fun fromStorageKey(key: String?): AutoDownloadSource =
+            entries.firstOrNull { it.storageKey.equals(key, ignoreCase = true) } ?: BOTH
+    }
+}
+
+object DownloadsSettingsRepository {
+    private val _downloadLocationUri = MutableStateFlow<String?>(null)
+    val downloadLocationUri: StateFlow<String?> = _downloadLocationUri.asStateFlow()
+
+    private val _autoDownloadSource = MutableStateFlow(AutoDownloadSource.BOTH)
+    val autoDownloadSource: StateFlow<AutoDownloadSource> = _autoDownloadSource.asStateFlow()
+
+    private val _preferredAddonId = MutableStateFlow<String?>(null)
+    val preferredAddonId: StateFlow<String?> = _preferredAddonId.asStateFlow()
+
+    private val _preferredRepositoryId = MutableStateFlow<String?>(null)
+    val preferredRepositoryId: StateFlow<String?> = _preferredRepositoryId.asStateFlow()
+
+    private var hasLoaded = false
+
+    fun ensureLoaded() {
+        if (hasLoaded) return
+        hasLoaded = true
+        _downloadLocationUri.value = DownloadsStorage.getDownloadLocationUri()
+        _autoDownloadSource.value = AutoDownloadSource.fromStorageKey(DownloadsStorage.getAutoDownloadSource())
+        _preferredAddonId.value = DownloadsStorage.getPreferredAddonId()
+        _preferredRepositoryId.value = DownloadsStorage.getPreferredRepositoryId()
+    }
+
+    fun onProfileChanged() {
+        hasLoaded = false
+        ensureLoaded()
+    }
+
+    fun setDownloadLocationUri(uri: String?) {
+        _downloadLocationUri.value = uri
+        DownloadsStorage.setDownloadLocationUri(uri)
+    }
+
+    fun setAutoDownloadSource(source: AutoDownloadSource) {
+        _autoDownloadSource.value = source
+        DownloadsStorage.setAutoDownloadSource(source.storageKey)
+    }
+
+    fun setPreferredAddonId(addonId: String?) {
+        _preferredAddonId.value = addonId
+        DownloadsStorage.setPreferredAddonId(addonId)
+    }
+
+    fun setPreferredRepositoryId(repositoryId: String?) {
+        _preferredRepositoryId.value = repositoryId
+        DownloadsStorage.setPreferredRepositoryId(repositoryId)
+    }
+}
