+        if (audioBytes > 0L) lines.add("$labelAudio: ${formatBytes(audioBytes)}")
+        if (subsBytes > 0L) lines.add("$labelSubs: ${formatBytes(subsBytes)}")
+
+        return if (lines.isEmpty()) null else lines.joinToString("\n")
+    }
