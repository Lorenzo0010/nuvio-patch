+
+private fun hlsOutputFileName(baseName: String, isFmp4: Boolean): String {
+    val targetExt = if (isFmp4) "mp4" else "ts"
+    val stem = baseName.substringBeforeLast('.')
+    return "$stem.$targetExt"
+}
+
+private fun hlsCompanionFileName(mainFileName: String, trackType: String, ext: String): String {
+    val stem = mainFileName.substringBeforeLast('.')
+    return "${stem}_$trackType.$ext"
+}
